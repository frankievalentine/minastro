# Optional. This file is an API-token alternative to the Wrangler OAuth login:
# `bun run cloudflare:setup` uses your `npx wrangler login` session by default
# and needs no credential file.
#
# Create this ignored copy only when you would rather provision with an
# account-scoped Cloudflare API token instead:
#
#   install -m 600 .env.cloudflare.local.example .env.cloudflare.local
#
# Then fill in the two blank values below in your own editor and run
# `bun run --env-file=.env.cloudflare.local cloudflare:setup`. The setup script
# never reads this file itself; `bun run --env-file` loads the values into that
# one command's environment only. The file is plaintext on disk, so delete it
# and revoke the token once the bootstrap secret is removed and no retry is
# pending. Least-privilege scopes are listed in docs/operations.md.
#
# Never commit the values, paste them into chat, or pass them on a command line.

# Account-scoped Cloudflare API token for the provisioning run.
CLOUDFLARE_API_TOKEN=

# 32-character hex ID of the Cloudflare account that owns the Worker and the
# custom-domain zone.
CLOUDFLARE_ACCOUNT_ID=
