# Copy to .env.cloudflare.local (which is git-ignored) and fill in for the
# `bun run --env-file=.env.cloudflare.local cloudflare:setup` provisioning
# run and the post-setup bootstrap-secret removal. Create the copy with
# `install -m 600 .env.cloudflare.local.example .env.cloudflare.local` so only
# your user can read it, then delete the file and revoke the token after the
# bootstrap secret is removed and no retry is pending. Setup never reads this
# file itself; `bun run --env-file` loads it
# into the command's environment only for that run.

# Account-scoped Cloudflare API token. Least-privilege scopes are listed in
# docs/operations.md. Never commit this value.
CLOUDFLARE_API_TOKEN=

# 32-character hex ID of the Cloudflare account that owns the Worker and the
# custom-domain zone.
CLOUDFLARE_ACCOUNT_ID=
