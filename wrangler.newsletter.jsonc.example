{
  /* ---- Newsletter bindings (merge into wrangler.jsonc after provisioning) ---- */
  /* NOTE: Bindings must be repeated per environment (preview, production)
     when using named environments in wrangler.jsonc. Each environment block
     needs its own d1_databases, send_email, and ratelimits entries. */
  "d1_databases": [
    { "binding": "NEWSLETTER_DB", "database_name": "minastro-newsletter", "database_id": "your-newsletter-db-id", "migrations_dir": "newsletter-migrations" }
  ],
  "send_email": [
    { "name": "NEWSLETTER_EMAIL", "remote": true, "allowed_sender_addresses": ["newsletter@your-domain.com"] }
  ],
  "ratelimits": [
    { "name": "NEWSLETTER_SUBSCRIBE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "RESEND_SEGMENT_ID": "your-resend-segment-id"
  }
}
