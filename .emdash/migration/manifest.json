{
  "posts": [
    {
      "status": "published",
      "slug": "working-with-mdx",
      "data": {
        "title": "Writing Posts with MDX",
        "description": "MDX lets you use components inside your Markdown. Here's a quick demonstration of what that looks like.",
        "content": [
          {
            "_type": "block",
            "_key": "k0002",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k0001",
                "text": "MDX is a superset of Markdown that lets you embed JSX components inline. This is useful for interactive demos, custom callouts, or anything that needs more structure than plain prose."
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k0004",
            "style": "h2",
            "children": [
              {
                "_type": "span",
                "_key": "k0003",
                "text": "A simple inline component"
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k0008",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k0005",
                "text": "You can import and use Astro components directly in "
              },
              {
                "_type": "span",
                "_key": "k0006",
                "text": ".mdx",
                "marks": [
                  "code"
                ]
              },
              {
                "_type": "span",
                "_key": "k0007",
                "text": " files:"
              }
            ]
          },
          {
            "_type": "code",
            "_key": "k0009",
            "language": "mdx",
            "code": "import MyComponent from \"../../components/MyComponent.astro\";\n\n<MyComponent message=\"Hello from MDX\" />"
          },
          {
            "_type": "block",
            "_key": "k000b",
            "style": "h2",
            "children": [
              {
                "_type": "span",
                "_key": "k000a",
                "text": "Expressive Code"
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k000g",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k000c",
                "text": "This template ships with "
              },
              {
                "_type": "span",
                "_key": "k000e",
                "text": "Expressive Code",
                "marks": [
                  "k000d"
                ]
              },
              {
                "_type": "span",
                "_key": "k000f",
                "text": " for syntax-highlighted code blocks with copy buttons, line numbers, and diff highlighting."
              }
            ],
            "markDefs": [
              {
                "_key": "k000d",
                "_type": "link",
                "href": "https://expressive-code.com/"
              }
            ]
          },
          {
            "_type": "code",
            "_key": "k000h",
            "language": "typescript",
            "code": "export function formatDate(date: Date): string {\n  return date.toLocaleDateString(\"en-US\", {\n    year: \"numeric\",\n    month: \"long\",\n    day: \"numeric\",\n  });\n}"
          },
          {
            "_type": "code",
            "_key": "k000i",
            "language": "diff",
            "code": "- const old = \"value\";\n+ const updated = \"new value\";"
          },
          {
            "_type": "block",
            "_key": "k000k",
            "style": "h2",
            "children": [
              {
                "_type": "span",
                "_key": "k000j",
                "text": "When to use MDX vs Markdown"
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k000q",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k000l",
                "text": "Use plain "
              },
              {
                "_type": "span",
                "_key": "k000m",
                "text": ".md",
                "marks": [
                  "code"
                ]
              },
              {
                "_type": "span",
                "_key": "k000n",
                "text": " files for posts that are entirely prose — no components needed. Reach for "
              },
              {
                "_type": "span",
                "_key": "k000o",
                "text": ".mdx",
                "marks": [
                  "code"
                ]
              },
              {
                "_type": "span",
                "_key": "k000p",
                "text": " when you want to drop in an interactive element, a custom callout card, or a structured data visualization."
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k000u",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k000r",
                "text": "Both file types are supported in "
              },
              {
                "_type": "span",
                "_key": "k000s",
                "text": "src/content/posts/",
                "marks": [
                  "code"
                ]
              },
              {
                "_type": "span",
                "_key": "k000t",
                "text": " and are picked up automatically by the content collection."
              }
            ]
          }
        ]
      },
      "createdAt": "2025-02-01T00:00:00.000Z",
      "publishedAt": "2025-02-01T00:00:00.000Z",
      "taxonomies": {
        "tag": [
          "mdx",
          "components",
          "astro"
        ]
      }
    },
    {
      "status": "published",
      "slug": "getting-started",
      "data": {
        "title": "Getting Started with minastro",
        "description": "A quick overview of what's included in this Astro starter and how to make it your own.",
        "content": [
          {
            "_type": "block",
            "_key": "k000w",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k000v",
                "text": "Welcome to your new Astro site. This post is here to show you what a basic Markdown post looks like and to point you toward the things you'll want to change first."
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k000y",
            "style": "h2",
            "children": [
              {
                "_type": "span",
                "_key": "k000x",
                "text": "What you should do first"
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k0012",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k000z",
                "text": "Open "
              },
              {
                "_type": "span",
                "_key": "k0010",
                "text": "src/site.config.ts",
                "marks": [
                  "code"
                ]
              },
              {
                "_type": "span",
                "_key": "k0011",
                "text": " and fill in your own details. Every piece of identity in this site — your name, bio, location, social links, analytics, and nav — is controlled from that one file. Change it once and it propagates everywhere."
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k0014",
            "style": "h2",
            "children": [
              {
                "_type": "span",
                "_key": "k0013",
                "text": "Content"
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k0018",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k0015",
                "text": "Posts live in "
              },
              {
                "_type": "span",
                "_key": "k0016",
                "text": "src/content/posts/",
                "marks": [
                  "code"
                ]
              },
              {
                "_type": "span",
                "_key": "k0017",
                "text": ". Each file is a Markdown or MDX file with frontmatter at the top. The required fields are:"
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k001b",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k0019",
                "text": "title",
                "marks": [
                  "code"
                ]
              },
              {
                "_type": "span",
                "_key": "k001a",
                "text": " — displayed in the post list and post header"
              }
            ],
            "listItem": "bullet",
            "level": 1
          },
          {
            "_type": "block",
            "_key": "k001e",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k001c",
                "text": "description",
                "marks": [
                  "code"
                ]
              },
              {
                "_type": "span",
                "_key": "k001d",
                "text": " — shown as a subtitle and used for SEO meta"
              }
            ],
            "listItem": "bullet",
            "level": 1
          },
          {
            "_type": "block",
            "_key": "k001i",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k001f",
                "text": "date",
                "marks": [
                  "code"
                ]
              },
              {
                "_type": "span",
                "_key": "k001g",
                "text": " — used for sorting; format as "
              },
              {
                "_type": "span",
                "_key": "k001h",
                "text": "YYYY-MM-DD",
                "marks": [
                  "code"
                ]
              }
            ],
            "listItem": "bullet",
            "level": 1
          },
          {
            "_type": "block",
            "_key": "k001l",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k001j",
                "text": "tags",
                "marks": [
                  "code"
                ]
              },
              {
                "_type": "span",
                "_key": "k001k",
                "text": " — optional array of strings displayed as badges"
              }
            ],
            "listItem": "bullet",
            "level": 1
          },
          {
            "_type": "block",
            "_key": "k001p",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k001m",
                "text": "Projects live in "
              },
              {
                "_type": "span",
                "_key": "k001n",
                "text": "src/content/projects/",
                "marks": [
                  "code"
                ]
              },
              {
                "_type": "span",
                "_key": "k001o",
                "text": ". See the example project files for the available frontmatter fields."
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k001r",
            "style": "h2",
            "children": [
              {
                "_type": "span",
                "_key": "k001q",
                "text": "Writing in Markdown"
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k001t",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k001s",
                "text": "Markdown renders with full prose styles. You can use headings, lists, blockquotes, inline code, and fenced code blocks."
              }
            ]
          },
          {
            "_type": "code",
            "_key": "k001u",
            "language": "typescript",
            "code": "const greeting = (name: string): string => {\n  return `Hello, ${name}`;\n};"
          },
          {
            "_type": "block",
            "_key": "k001w",
            "style": "blockquote",
            "children": [
              {
                "_type": "span",
                "_key": "k001v",
                "text": "A blockquote looks like this. Use them for callouts or pull quotes."
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k0024",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k001x",
                "text": "Bold text",
                "marks": [
                  "strong"
                ]
              },
              {
                "_type": "span",
                "_key": "k001y",
                "text": " and "
              },
              {
                "_type": "span",
                "_key": "k001z",
                "text": "italic text",
                "marks": [
                  "em"
                ]
              },
              {
                "_type": "span",
                "_key": "k0020",
                "text": " work as expected. Links "
              },
              {
                "_type": "span",
                "_key": "k0022",
                "text": "look like this",
                "marks": [
                  "k0021"
                ]
              },
              {
                "_type": "span",
                "_key": "k0023",
                "text": "."
              }
            ],
            "markDefs": [
              {
                "_key": "k0021",
                "_type": "link",
                "href": "https://astro.build"
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k0026",
            "style": "h2",
            "children": [
              {
                "_type": "span",
                "_key": "k0025",
                "text": "Deleting this post"
              }
            ]
          },
          {
            "_type": "block",
            "_key": "k0028",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "k0027",
                "text": "Once you've read through it, delete this file and add your own writing. That's the whole point."
              }
            ]
          }
        ]
      },
      "createdAt": "2025-01-15T00:00:00.000Z",
      "publishedAt": "2025-01-15T00:00:00.000Z",
      "taxonomies": {
        "tag": [
          "astro",
          "template",
          "guide"
        ]
      }
    }
