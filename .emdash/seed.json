{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "minastro",
    "description": "A minimal personal site powered by EmDash CMS."
  },
  "settings": {
    "title": "Your Name",
    "tagline": "Your title",
    "postsPerPage": 10,
    "dateFormat": "MMMM d, yyyy",
    "timezone": "UTC"
  },
  "collections": [
    {
      "slug": "posts",
      "label": "Posts",
      "labelSingular": "Post",
      "description": "Blog posts and articles",
      "icon": "file-text",
      "supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
      "urlPattern": "/posts/{slug}",
      "commentsEnabled": true,
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "description", "label": "Description", "type": "text", "required": true },
        { "slug": "content", "label": "Content", "type": "portableText" },
        { "slug": "featured", "label": "Featured", "type": "boolean" },
        { "slug": "featured_image", "label": "Featured image", "type": "image" }
      ]
    },
    {
      "slug": "projects",
      "label": "Projects",
      "labelSingular": "Project",
      "description": "Portfolio projects and open-source work",
      "icon": "folder",
      "supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
      "urlPattern": "/projects/{slug}",
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "description", "label": "Description", "type": "text", "required": true },
        { "slug": "content", "label": "Content", "type": "portableText" },
        { "slug": "project_status", "label": "Project status", "type": "string" },
        { "slug": "url", "label": "URL", "type": "url" },
        { "slug": "github", "label": "GitHub", "type": "url" },
        { "slug": "featured", "label": "Featured", "type": "boolean" },
        { "slug": "featured_image", "label": "Featured image", "type": "image" }
      ]
    },
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "description": "CMS-managed site pages",
      "icon": "file-text",
      "supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
      "urlPattern": "/{slug}",
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "description", "label": "Description", "type": "text", "required": true },
        { "slug": "content", "label": "Content", "type": "portableText" }
      ]
    },
    {
      "slug": "home",
      "label": "Home",
      "labelSingular": "Home",
      "description": "Homepage editorial content",
      "icon": "home",
      "supports": ["drafts", "revisions", "preview"],
      "fields": [
        { "slug": "eyebrow", "label": "Eyebrow", "type": "string" },
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "description", "label": "Description", "type": "text", "required": true },
        { "slug": "highlights_title", "label": "Highlights title", "type": "string", "required": true },
        { "slug": "highlights_description", "label": "Highlights description", "type": "text" },
        { "slug": "posts_title", "label": "Posts title", "type": "string", "required": true },
        { "slug": "posts_description", "label": "Posts description", "type": "text" },
        { "slug": "projects_title", "label": "Projects title", "type": "string", "required": true },
        { "slug": "projects_description", "label": "Projects description", "type": "text" },
        { "slug": "newsletter_cta_label", "label": "Newsletter CTA label", "type": "string", "required": true },
        { "slug": "newsletter_cta_href", "label": "Newsletter CTA URL", "type": "string", "required": true }
      ]
    },
    {
      "slug": "home_highlights",
      "label": "Home Highlights",
      "labelSingular": "Home Highlight",
      "description": "Ordered feature cards for the homepage",
      "icon": "sparkles",
      "supports": ["drafts", "revisions", "preview"],
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "description", "label": "Description", "type": "text", "required": true },
        { "slug": "icon_key", "label": "Icon", "type": "select", "required": true, "validation": { "options": ["database", "workflow", "search", "mail"] } },
        { "slug": "sort_order", "label": "Sort order", "type": "number", "required": true }
      ]
    },
    {
      "slug": "navigation_icons",
      "label": "Navigation Icons",
      "labelSingular": "Navigation Icon",
      "description": "Sidebar icon choices for CMS Pages",
      "icon": "menu",
      "supports": ["drafts", "revisions"],
      "fields": [
        { "slug": "page", "label": "Page", "type": "reference", "required": true, "options": { "collection": "pages" } },
        { "slug": "icon_key", "label": "Icon", "type": "select", "required": true, "validation": { "options": ["page", "book", "user", "briefcase", "compass", "link", "file", "folder", "calendar", "heart", "star", "lightbulb", "globe", "code", "camera", "music", "message", "settings"] } }
      ]
    }
  ],
  "taxonomies": [
    {
      "name": "tag",
      "label": "Tags",
      "labelSingular": "Tag",
      "hierarchical": false,
      "collections": ["posts", "projects"]
    }
  ],
  "menus": [
    {
      "name": "primary",
      "label": "Primary Navigation",
      "items": [
        { "type": "custom", "label": "About", "url": "/" },
        { "type": "custom", "label": "Posts", "url": "/posts" },
        { "type": "custom", "label": "Projects", "url": "/projects" },
        { "type": "custom", "label": "Newsletter", "url": "/newsletter" }
      ]
    }
  ],
  "content": {
    "home": [
      {
        "id": "home",
        "slug": "home",
        "status": "published",
        "data": {
          "eyebrow": "minastro",
          "title": "A focused home for your work.",
          "description": "Minastro is a quiet, responsive starter for publishing thoughtful posts and showing the projects behind them. EmDash is the source of truth for content, and the complete site deploys directly to Cloudflare.",
          "highlights_title": "Highlighted features",
          "highlights_description": "A practical publishing foundation, already connected from editing through deployment.",
          "posts_title": "Latest writing",
          "posts_description": "Published posts from EmDash, ordered by date.",
          "projects_title": "Selected work",
          "projects_description": "Featured projects from EmDash, ordered by date.",
          "newsletter_cta_label": "Subscribe to the newsletter",
          "newsletter_cta_href": "/newsletter"
        }
      }
    ],
    "home_highlights": [
      { "id": "home-highlight-content", "slug": "emdash-managed-content", "status": "published", "data": { "title": "EmDash-managed content", "description": "Manage posts, projects, menus, settings, and media without moving content into the codebase.", "icon_key": "database", "sort_order": 1 } },
      { "id": "home-highlight-cloudflare", "slug": "one-command-cloudflare-setup", "status": "published", "data": { "title": "One-command Cloudflare setup", "description": "Provision the required bindings and deploy with bun run cloudflare:setup.", "icon_key": "workflow", "sort_order": 2 } },
      { "id": "home-highlight-discovery", "slug": "search-and-rss", "status": "published", "data": { "title": "Search and RSS", "description": "Built-in search and an RSS feed keep published work easy to find and follow.", "icon_key": "search", "sort_order": 3 } },
      { "id": "home-highlight-newsletter", "slug": "opt-in-newsletter", "status": "published", "data": { "title": "Opt-in newsletter", "description": "Add Turnstile-protected signup and Resend delivery only when the publication needs it.", "icon_key": "mail", "sort_order": 4 } }
    ],
    "posts": [
      {
        "id": "welcome-to-your-site",
        "slug": "welcome-to-your-site",
        "status": "published",
        "data": {
          "title": "Welcome to your site",
          "description": "Your first EmDash-powered post is already published and ready to edit.",
          "content": [
            {
              "_type": "block",
              "_key": "welcome-intro",
              "style": "normal",
              "children": [
                { "_type": "span", "_key": "welcome-intro-1", "text": "This template starts with EmDash as its only content source. Everything you read here is stored in your D1 database and rendered by Astro on Cloudflare Workers. Open the admin at " },
                { "_type": "span", "_key": "welcome-intro-2", "text": "/_emdash/admin", "marks": ["code"] },
                { "_type": "span", "_key": "welcome-intro-3", "text": " to edit this post, then make it your own." }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "welcome-h2",
              "style": "h2",
              "children": [
                { "_type": "span", "_key": "welcome-h2-1", "text": "What you can write" }
              ]
            },
            {
              "_type": "block",
              "_key": "welcome-marks-p",
              "style": "normal",
              "children": [
                { "_type": "span", "_key": "welcome-marks-1", "text": "The editor supports the formatting you expect: " },
                { "_type": "span", "_key": "welcome-marks-2", "text": "bold text", "marks": ["strong"] },
                { "_type": "span", "_key": "welcome-marks-3", "text": ", " },
                { "_type": "span", "_key": "welcome-marks-4", "text": "italic emphasis", "marks": ["em"] },
                { "_type": "span", "_key": "welcome-marks-5", "text": ", " },
                { "_type": "span", "_key": "welcome-marks-6", "text": "underline", "marks": ["underline"] },
                { "_type": "span", "_key": "welcome-marks-7", "text": ", and even " },
                { "_type": "span", "_key": "welcome-marks-8", "text": "struck-through revisions", "marks": ["strike-through"] },
                { "_type": "span", "_key": "welcome-marks-9", "text": ". You can also link to " },
                { "_type": "span", "_key": "welcome-marks-10", "text": "the Astro documentation", "marks": ["welcome-link-astro"] },
                { "_type": "span", "_key": "welcome-marks-11", "text": " when you need a reference while writing." }
              ],
              "markDefs": [
                {
                  "_type": "link",
                  "_key": "welcome-link-astro",
                  "href": "https://docs.astro.build",
                  "blank": true
                }
              ]
            },
            {
              "_type": "block",
              "_key": "welcome-list-bullet",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "children": [
                { "_type": "span", "_key": "welcome-list-bullet-1", "text": "Posts and projects live in CMS collections you can reshape in the admin." }
              ]
            },
            {
              "_type": "block",
              "_key": "welcome-list-number",
              "style": "normal",
              "listItem": "number",
              "level": 1,
              "children": [
                { "_type": "span", "_key": "welcome-list-number-1", "text": "Sign in, open this post, replace the copy, and publish your first update." }
              ]
            },
            {
              "_type": "block",
              "_key": "welcome-quote",
              "style": "blockquote",
              "children": [
                { "_type": "span", "_key": "welcome-quote-1", "text": "Publish before it feels finished. A small site that ships beats a perfect one that never launches." }
              ]
            },
            {
              "_type": "block",
              "_key": "welcome-code-p",
              "style": "normal",
              "children": [
                { "_type": "span", "_key": "welcome-code-p-1", "text": "This starter code block includes a language and filename, so Minastro renders it with syntax highlighting:" }
              ]
            },
            {
              "_type": "code",
              "_key": "welcome-code",
              "code": "export function greet(name: string): string {\n  return `Hello, ${name}!`;\n}\n\nconsole.log(greet(\"EmDash\"));",
              "language": "typescript",
              "filename": "example.ts"
            },
            {
              "_type": "block",
              "_key": "welcome-outro",
              "style": "normal",
              "children": [
                { "_type": "span", "_key": "welcome-outro-1", "text": "When you are done exploring, delete this post and start writing. Your database, media, and deployment are already wired up." }
              ]
            }
          ]
        },
        "taxonomies": { "tag": ["getting-started"] }
      },
      {
        "id": "writing-in-public",
        "slug": "writing-in-public",
        "status": "published",
        "data": {
          "title": "Writing in public",
          "description": "A small note about making progress visible before the work feels finished.",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                { "_type": "span", "text": "Use this second post to explore the editor, preview flow, tags, and publishing controls." }
              ]
            }
          ]
        },
        "taxonomies": { "tag": ["notes"] }
      }
    ],
    "projects": [
      {
        "id": "personal-site",
        "slug": "personal-site",
        "status": "published",
        "data": {
          "title": "Personal site",
          "description": "A focused home for writing, projects, and an evolving body of work.",
          "project_status": "active",
          "url": "https://your-domain.com",
          "github": "https://github.com/yourusername/minastro",
          "featured": true,
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                { "_type": "span", "text": "This sample project demonstrates the project fields, featured placement, and Portable Text content." }
              ]
            }
          ]
        },
        "taxonomies": { "tag": ["astro", "emdash"] }
      },
      {
        "id": "open-source-tool",
        "slug": "open-source-tool",
        "status": "published",
        "data": {
          "title": "Open-source tool",
          "description": "A placeholder project for experimenting with links, status, and tags.",
          "project_status": "wip",
          "featured": true,
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                { "_type": "span", "text": "Edit this project in EmDash, or delete it when you are ready to publish your own work." }
              ]
            }
          ]
        },
        "taxonomies": { "tag": ["open-source"] }
      }
    ],
    "pages": [
      {
        "id": "start-here",
        "slug": "start-here",
        "status": "published",
        "data": {
          "title": "Start here",
          "description": "A CMS-managed page you can replace, reorder in the sidebar, or remove when making Minastro your own.",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                { "_type": "span", "text": "This page is managed in EmDash. Edit it in the Pages collection, then update the Primary Navigation menu to control where it appears in the sidebar." }
              ]
            }
          ]
        }
      }
    ]
  }
}
