{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "minastro",
    "description": "A minimal personal site powered by EmDash CMS."
  },
  "settings": {
    "title": "Your Name",
    "tagline": "Your title",
    "postsPerPage": 10,
    "dateFormat": "MMMM d, yyyy",
    "timezone": "UTC"
  },
  "collections": [
    {
      "slug": "posts",
      "label": "Posts",
      "labelSingular": "Post",
      "description": "Blog posts and articles",
      "icon": "file-text",
      "supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
      "urlPattern": "/posts/{slug}",
      "commentsEnabled": true,
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
        { "slug": "description", "label": "Description", "type": "text", "required": true },
        { "slug": "content", "label": "Content", "type": "portableText", "searchable": true },
        { "slug": "featured", "label": "Featured", "type": "boolean" },
        { "slug": "featured_image", "label": "Featured image", "type": "image" }
      ]
    },
    {
      "slug": "projects",
      "label": "Projects",
      "labelSingular": "Project",
      "description": "Portfolio projects and open-source work",
      "icon": "folder",
      "supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
      "urlPattern": "/projects/{slug}",
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
        { "slug": "description", "label": "Description", "type": "text", "required": true },
        { "slug": "content", "label": "Content", "type": "portableText", "searchable": true },
        { "slug": "project_status", "label": "Project status", "type": "string" },
        { "slug": "url", "label": "URL", "type": "url" },
        { "slug": "github", "label": "GitHub", "type": "url" },
        { "slug": "featured", "label": "Featured", "type": "boolean" },
        { "slug": "featured_image", "label": "Featured image", "type": "image" }
      ]
    },
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "description": "CMS-managed site pages",
      "icon": "file-text",
      "supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
      "urlPattern": "/{slug}",
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "description", "label": "Description", "type": "text", "required": true },
        { "slug": "content", "label": "Content", "type": "portableText" }
      ]
    },
    {
      "slug": "home",
      "label": "Home",
      "labelSingular": "Home",
      "description": "Homepage editorial content",
      "icon": "home",
      "supports": ["drafts", "revisions", "preview"],
      "fields": [
        { "slug": "eyebrow", "label": "Eyebrow", "type": "string" },
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "description", "label": "Description", "type": "text", "required": true },
        { "slug": "highlights_title", "label": "Highlights title", "type": "string", "required": true },
        { "slug": "highlights_description", "label": "Highlights description", "type": "text" },
        { "slug": "posts_title", "label": "Posts title", "type": "string", "required": true },
        { "slug": "posts_description", "label": "Posts description", "type": "text" },
        { "slug": "projects_title", "label": "Projects title", "type": "string", "required": true },
        { "slug": "projects_description", "label": "Projects description", "type": "text" },
        { "slug": "newsletter_cta_label", "label": "Newsletter CTA label", "type": "string", "required": true },
        { "slug": "newsletter_cta_href", "label": "Newsletter CTA URL", "type": "string", "required": true }
      ]
    },
    {
      "slug": "home_highlights",
      "label": "Home Highlights",
      "labelSingular": "Home Highlight",
      "description": "Ordered feature cards for the homepage",
      "icon": "sparkles",
      "supports": ["drafts", "revisions", "preview"],
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "description", "label": "Description", "type": "text", "required": true },
        { "slug": "icon_key", "label": "Icon", "type": "select", "required": true, "validation": { "options": ["database", "workflow", "search", "mail"] } },
        { "slug": "sort_order", "label": "Sort order", "type": "number", "required": true }
      ]
    },
    {
      "slug": "listing_headers",
      "label": "Listing Headers",
      "labelSingular": "Listing Header",
      "description": "Optional singleton override for the Posts and Projects eyebrow labels and icons. Edit only the seeded listing-headers record; page titles and descriptions remain theme-owned.",
      "icon": "settings",
      "supports": ["drafts", "revisions"],
      "fields": [
        { "slug": "posts_label", "label": "Posts label", "type": "string" },
        { "slug": "posts_icon", "label": "Posts icon", "type": "select", "validation": { "options": ["posts", "projects", "book", "briefcase", "file", "folder", "code", "lightbulb"] } },
        { "slug": "projects_label", "label": "Projects label", "type": "string" },
        { "slug": "projects_icon", "label": "Projects icon", "type": "select", "validation": { "options": ["posts", "projects", "book", "briefcase", "file", "folder", "code", "lightbulb"] } }
      ]
    },
    {
      "slug": "newsletter_page",
      "label": "Newsletter Page",
      "labelSingular": "Newsletter Page",
      "description": "Optional singleton editorial override for the public newsletter page. Edit only the seeded newsletter record; when it is absent or unpublished, the theme uses its complete local default. Operational delivery and security settings remain outside the CMS.",
      "icon": "mail",
      "supports": ["drafts", "revisions"],
      "fields": [
        { "slug": "eyebrow", "label": "Eyebrow", "type": "string" },
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "description", "label": "Introduction", "type": "text", "required": true },
        { "slug": "signup_title", "label": "Signup heading", "type": "string", "required": true },
        { "slug": "signup_description", "label": "Signup description", "type": "text", "required": true },
        { "slug": "name_label", "label": "Name label", "type": "string", "required": true },
        { "slug": "name_optional_label", "label": "Name optional label", "type": "string" },
        { "slug": "name_placeholder", "label": "Name placeholder", "type": "string" },
        { "slug": "email_label", "label": "Email label", "type": "string", "required": true },
        { "slug": "email_placeholder", "label": "Email placeholder", "type": "string" },
        { "slug": "email_help", "label": "Email help", "type": "text" },
        { "slug": "submit_label", "label": "Submit label", "type": "string", "required": true },
        { "slug": "submitting_label", "label": "Submitting label", "type": "string", "required": true },
        { "slug": "consent_copy", "label": "Consent and disclaimer", "type": "text", "required": true },
        { "slug": "success_title", "label": "Success heading", "type": "string", "required": true },
        { "slug": "success_message", "label": "Success message", "type": "text", "required": true },
        { "slug": "disabled_heading", "label": "Disabled-state heading", "type": "string", "required": true },
        { "slug": "disabled_body", "label": "Disabled-state body", "type": "text", "required": true },
        { "slug": "expectations_title", "label": "Expectations heading", "type": "string", "required": true },
        { "slug": "expectation_one_title", "label": "First expectation title", "type": "string", "required": true },
        { "slug": "expectation_one_description", "label": "First expectation description", "type": "text", "required": true },
        { "slug": "expectation_two_title", "label": "Second expectation title", "type": "string", "required": true },
        { "slug": "expectation_two_description", "label": "Second expectation description", "type": "text", "required": true },
        { "slug": "expectation_three_title", "label": "Third expectation title", "type": "string", "required": true },
        { "slug": "expectation_three_description", "label": "Third expectation description", "type": "text", "required": true }
      ]
    },
    {
      "slug": "navigation_icons",
      "label": "Navigation Icons",
      "labelSingular": "Navigation Icon",
      "description": "Sidebar icon choices for CMS Pages",
      "icon": "menu",
      "supports": ["drafts", "revisions"],
      "fields": [
        { "slug": "page", "label": "Page", "type": "reference", "required": true, "options": { "collection": "pages" } },
        { "slug": "icon_key", "label": "Icon", "type": "select", "required": true, "validation": { "options": ["page", "book", "user", "briefcase", "compass", "link", "file", "folder", "calendar", "heart", "star", "lightbulb", "globe", "code", "camera", "music", "message", "settings"] } }
      ]
    }
  ],
  "taxonomies": [
    {
      "name": "tag",
      "label": "Tags",
      "labelSingular": "Tag",
      "hierarchical": false,
      "collections": ["posts", "projects"]
    }
  ],
  "menus": [
    {
      "name": "primary",
      "label": "Primary Navigation",
      "items": [
        { "type": "custom", "label": "About", "url": "/" },
        { "type": "custom", "label": "Posts", "url": "/posts" },
        { "type": "custom", "label": "Projects", "url": "/projects" },
        { "type": "custom", "label": "Newsletter", "url": "/newsletter" }
      ]
    }
  ],
  "content": {
    "newsletter_page": [
      {
        "id": "newsletter",
        "slug": "newsletter",
        "status": "published",
        "data": {
          "eyebrow": "Newsletter",
          "title": "Stay in the loop",
          "description": "Occasional notes on engineering, projects, and ideas. No spam.",
          "signup_title": "Subscribe for new notes",
          "signup_description": "Get new writing and project updates in your inbox when there is something useful to share.",
          "name_label": "Name",
          "name_optional_label": "(optional)",
          "name_placeholder": "Your name",
          "email_label": "Email address",
          "email_placeholder": "you@example.com",
          "email_help": "You can unsubscribe from any email.",
          "submit_label": "Subscribe",
          "submitting_label": "Subscribing…",
          "consent_copy": "By subscribing, you consent to receive this newsletter. Your email is used only for newsletter communications and can be removed at any time.",
          "success_title": "Check your inbox",
          "success_message": "If this address can be subscribed, you will receive a confirmation email shortly. Use the link there to finish subscribing.",
          "disabled_heading": "Newsletter coming soon",
          "disabled_body": "Signup is not open yet. Check back here for future updates.",
          "expectations_title": "What to expect",
          "expectation_one_title": "Engineering notes",
          "expectation_one_description": "Practical notes on building, debugging, and maintaining software.",
          "expectation_two_title": "Project updates",
          "expectation_two_description": "Short updates on open-source work, experiments, and useful tools.",
          "expectation_three_title": "A focused pace",
          "expectation_three_description": "Occasional delivery, only when there is something worth sending."
        }
      }
    ],
    "listing_headers": [
      {
        "id": "listing-headers",
        "slug": "listing-headers",
        "status": "published",
        "data": {
          "posts_label": "Writing",
          "posts_icon": "posts",
          "projects_label": "Work",
          "projects_icon": "projects"
        }
      }
    ],
    "home": [
      {
        "id": "home",
        "slug": "home",
        "status": "published",
        "data": {
          "title": "A focused home for thoughtful work.",
          "description": "A personal space for considered writing, current projects, and the lessons gathered along the way.",
          "highlights_title": "What you'll find here",
          "highlights_description": "A growing collection of notes, experiments, and useful work.",
          "posts_title": "Latest writing",
          "posts_description": "Recent notes and essays, ordered by date.",
          "projects_title": "Selected work",
          "projects_description": "A selection of current and completed projects.",
          "newsletter_cta_label": "Subscribe to the newsletter",
          "newsletter_cta_href": "/newsletter"
        }
      }
    ],
    "home_highlights": [
      { "id": "home-highlight-content", "slug": "collected-notes", "status": "published", "data": { "title": "Collected notes", "description": "Essays and shorter observations about what is being learned, built, and reconsidered.", "icon_key": "database", "sort_order": 1 } },
      { "id": "home-highlight-cloudflare", "slug": "work-in-progress", "status": "published", "data": { "title": "Work in progress", "description": "Projects capture both finished outcomes and the thinking that shaped them.", "icon_key": "workflow", "sort_order": 2 } },
      { "id": "home-highlight-discovery", "slug": "easy-to-explore", "status": "published", "data": { "title": "Easy to explore", "description": "Search and an RSS feed make published work straightforward to find and follow.", "icon_key": "search", "sort_order": 3 } },
      { "id": "home-highlight-newsletter", "slug": "occasional-updates", "status": "published", "data": { "title": "Occasional updates", "description": "A quiet newsletter shares new writing only when there is something useful to send.", "icon_key": "mail", "sort_order": 4 } }
    ],
    "posts": [
      {
        "id": "welcome-to-your-site",
        "slug": "welcome-to-your-site",
        "status": "published",
        "data": {
          "title": "Welcome to your site",
          "description": "Your first EmDash-powered post is already published and ready to edit.",
          "content": [
            {
              "_type": "block",
              "_key": "welcome-intro",
              "style": "normal",
              "children": [
                { "_type": "span", "_key": "welcome-intro-1", "text": "This template starts with EmDash as its only content source. Everything you read here is stored in your D1 database and rendered by Astro on Cloudflare Workers. Open the admin at " },
                { "_type": "span", "_key": "welcome-intro-2", "text": "/_emdash/admin", "marks": ["code"] },
                { "_type": "span", "_key": "welcome-intro-3", "text": " to edit this post, then make it your own." }
              ],
              "markDefs": []
            },
            {
              "_type": "block",
              "_key": "welcome-h2",
              "style": "h2",
              "children": [
                { "_type": "span", "_key": "welcome-h2-1", "text": "What you can write" }
              ]
            },
            {
              "_type": "block",
              "_key": "welcome-marks-p",
              "style": "normal",
              "children": [
                { "_type": "span", "_key": "welcome-marks-1", "text": "The editor supports the formatting you expect: " },
                { "_type": "span", "_key": "welcome-marks-2", "text": "bold text", "marks": ["strong"] },
                { "_type": "span", "_key": "welcome-marks-3", "text": ", " },
                { "_type": "span", "_key": "welcome-marks-4", "text": "italic emphasis", "marks": ["em"] },
                { "_type": "span", "_key": "welcome-marks-5", "text": ", " },
                { "_type": "span", "_key": "welcome-marks-6", "text": "underline", "marks": ["underline"] },
                { "_type": "span", "_key": "welcome-marks-7", "text": ", and even " },
                { "_type": "span", "_key": "welcome-marks-8", "text": "struck-through revisions", "marks": ["strike-through"] },
                { "_type": "span", "_key": "welcome-marks-9", "text": ". You can also link to " },
                { "_type": "span", "_key": "welcome-marks-10", "text": "the Astro documentation", "marks": ["welcome-link-astro"] },
                { "_type": "span", "_key": "welcome-marks-11", "text": " when you need a reference while writing." }
              ],
              "markDefs": [
                {
                  "_type": "link",
                  "_key": "welcome-link-astro",
                  "href": "https://docs.astro.build",
                  "blank": true
                }
              ]
            },
            {
              "_type": "block",
              "_key": "welcome-list-bullet",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "children": [
                { "_type": "span", "_key": "welcome-list-bullet-1", "text": "Posts and projects live in CMS collections you can reshape in the admin." }
              ]
            },
            {
              "_type": "block",
              "_key": "welcome-list-number",
              "style": "normal",
              "listItem": "number",
              "level": 1,
              "children": [
                { "_type": "span", "_key": "welcome-list-number-1", "text": "Sign in, open this post, replace the copy, and publish your first update." }
              ]
            },
            {
              "_type": "block",
              "_key": "welcome-quote",
              "style": "blockquote",
              "children": [
                { "_type": "span", "_key": "welcome-quote-1", "text": "Publish before it feels finished. A small site that ships beats a perfect one that never launches." }
              ]
            },
            {
              "_type": "block",
              "_key": "welcome-code-p",
              "style": "normal",
              "children": [
                { "_type": "span", "_key": "welcome-code-p-1", "text": "This starter code block includes a language and filename, so Minastro renders it with syntax highlighting:" }
              ]
            },
            {
              "_type": "code",
              "_key": "welcome-code",
              "code": "export function greet(name: string): string {\n  return `Hello, ${name}!`;\n}\n\nconsole.log(greet(\"EmDash\"));",
              "language": "typescript",
              "filename": "example.ts"
            },
            {
              "_type": "block",
              "_key": "welcome-outro",
              "style": "normal",
              "children": [
                { "_type": "span", "_key": "welcome-outro-1", "text": "When you are done exploring, delete this post and start writing. Your database, media, and deployment are already wired up." }
              ]
            }
          ]
        },
        "taxonomies": { "tag": ["getting-started"] }
      },
      {
        "id": "writing-in-public",
        "slug": "writing-in-public",
        "status": "published",
        "data": {
          "title": "Writing in public",
          "description": "A small note about making progress visible before the work feels finished.",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                { "_type": "span", "text": "Use this second post to explore the editor, preview flow, tags, and publishing controls." }
              ]
            }
          ]
        },
        "taxonomies": { "tag": ["notes"] }
      }
    ],
    "projects": [
      {
        "id": "personal-site",
        "slug": "personal-site",
        "status": "published",
        "data": {
          "title": "Personal site",
          "description": "A focused home for writing, projects, and an evolving body of work.",
          "project_status": "active",
          "featured": true,
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                { "_type": "span", "text": "This sample project demonstrates the project fields, featured placement, and Portable Text content." }
              ]
            }
          ]
        },
        "taxonomies": { "tag": ["astro", "emdash"] }
      },
      {
        "id": "open-source-tool",
        "slug": "open-source-tool",
        "status": "published",
        "data": {
          "title": "Open-source tool",
          "description": "A placeholder project for experimenting with links, status, and tags.",
          "project_status": "wip",
          "featured": true,
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                { "_type": "span", "text": "Edit this project in EmDash, or delete it when you are ready to publish your own work." }
              ]
            }
          ]
        },
        "taxonomies": { "tag": ["open-source"] }
      }
    ],
    "pages": [
      {
        "id": "start-here",
        "slug": "start-here",
        "status": "published",
        "data": {
          "title": "Start here",
          "description": "A CMS-managed page you can replace, reorder in the sidebar, or remove when making Minastro your own.",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                { "_type": "span", "text": "This page is managed in EmDash. Edit it in the Pages collection, then update the Primary Navigation menu to control where it appears in the sidebar." }
              ]
            }
          ]
        }
      }
    ]
  }
}
