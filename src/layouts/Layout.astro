---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Search from "../components/Search.astro";
import SidebarNavigationIcon from "../components/SidebarNavigationIcon.astro";
import { siteConfig } from "../site.config";
import { getEmDashCollection, getMenu, getSiteSettings } from "emdash";

interface Props {
  currentPage?: string;
  description?: string;
  standalone?: boolean;
  title?: string;
}

type NavigationIconKey = "page" | "book" | "user" | "briefcase" | "compass" | "link" | "file" | "folder" | "calendar" | "heart" | "star" | "lightbulb" | "globe" | "code" | "camera" | "music" | "message" | "settings";

const navigationIconKeys = new Set<NavigationIconKey>([
  "page",
  "book",
  "user",
  "briefcase",
  "compass",
  "link",
  "file",
  "folder",
  "calendar",
  "heart",
  "star",
  "lightbulb",
  "globe",
  "code",
  "camera",
  "music",
  "message",
  "settings",
]);

const [cmsSettings, primaryMenu, navigationIconsResult, pagesResult] = await Promise.all([
  getSiteSettings(),
  getMenu("primary"),
  getEmDashCollection("navigation_icons", { status: "published" }),
  getEmDashCollection("pages", { status: "published" }),
]);

if (navigationIconsResult.error) {
  throw navigationIconsResult.error;
}

if (pagesResult.error) {
  throw pagesResult.error;
}

const pageUrlsByReference = new Map<string, string>();
for (const { id, data } of pagesResult.entries) {
  const slug = typeof data.slug === "string" && data.slug.trim() ? data.slug : undefined;
  if (!slug) continue;
  const url = `/${slug}`;
  pageUrlsByReference.set(id, url);
  pageUrlsByReference.set(slug, url);
  if (typeof data.id === "string" && data.id.trim()) {
    pageUrlsByReference.set(data.id, url);
  }
}

const pageNavigationIcons = new Map<string, NavigationIconKey>();
for (const { data } of navigationIconsResult.entries) {
  const reference = typeof data.page === "string" ? data.page.trim() : "";
  const iconKey = data.icon_key;
  if (
    !reference ||
    typeof iconKey !== "string" ||
    !navigationIconKeys.has(iconKey as NavigationIconKey)
  ) {
    continue;
  }
  const pageUrl = pageUrlsByReference.get(reference);
  if (pageUrl && !pageNavigationIcons.has(pageUrl)) {
    pageNavigationIcons.set(pageUrl, iconKey as NavigationIconKey);
  }
}

const cmsTitle =
  typeof cmsSettings?.title === "string" && cmsSettings.title.trim()
    ? cmsSettings.title
    : null;
const cmsTagline =
  typeof cmsSettings?.tagline === "string" && cmsSettings.tagline.trim()
    ? cmsSettings.tagline
    : null;
const cmsLogo =
  typeof cmsSettings?.logo?.url === "string" && cmsSettings.logo.url.trim()
    ? cmsSettings.logo.url
    : null;
const socialProfileUrl = (value: string | undefined, profileBase: string): string | undefined => {
  if (typeof value !== "string" || !value.trim()) return undefined;
  const candidate = value.trim();
  try {
    const url = new URL(candidate);
    return url.protocol === "http:" || url.protocol === "https:" ? url.href : undefined;
  } catch {
    const handle = candidate.replace(/^@/, "");
    return /^[a-zA-Z0-9][a-zA-Z0-9._-]*$/.test(handle)
      ? `${profileBase}${encodeURIComponent(handle)}`
      : undefined;
  }
};
const preferredSocialValue = (cmsValue: string | undefined, fallback: string | undefined) =>
  typeof cmsValue === "string" && cmsValue.trim() ? cmsValue : fallback;
const social = {
  github: socialProfileUrl(preferredSocialValue(cmsSettings?.social?.github, siteConfig.social.github), "https://github.com/"),
  twitter: socialProfileUrl(preferredSocialValue(cmsSettings?.social?.twitter, siteConfig.social.twitter), "https://x.com/"),
  linkedin: socialProfileUrl(preferredSocialValue(cmsSettings?.social?.linkedin, siteConfig.social.linkedin), "https://www.linkedin.com/in/"),
  email: siteConfig.social.email,
};
// Runtime identity is CMS-owned only. A missing site title is a visible
// configuration failure, not a fallback condition.
if (!cmsTitle) {
  throw new Error(
    "CMS site settings are missing a title. Set one in EmDash → Settings; there is no local identity fallback.",
  );
}
const siteName = cmsTitle;
const siteTagline = cmsTagline ?? "";

const cmsNav = (primaryMenu?.items ?? [])
  .filter(
    (item) =>
      typeof item?.label === "string" &&
      item.label.trim() &&
      typeof item?.url === "string" &&
      item.url.trim(),
  )
  .map((item) => ({
    label: item.label,
    href: item.url,
    target: typeof item.target === "string" ? item.target : undefined,
  }));
// A resolved primary menu is authoritative, even when intentionally empty.
// With no menu configured, the sidebar simply renders no navigation items.
const primaryNav = cmsNav;

const {
  title: pageTitle,
  description: pageDescription,
  currentPage = "/",
  standalone = false,
} = Astro.props;
const title = pageTitle ?? siteName;
const description = pageDescription ?? cmsTagline ?? "";

const siteTitle =
  title === siteName ? title : `${title} • ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

function isActive(href: string): boolean {
  if (href === "/") {
    return currentPage === "/";
  }
  return currentPage === href || currentPage.startsWith(`${href}/`);
}

const avatarInitial = siteName.charAt(0).toUpperCase();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="generator" content={Astro.generator}>

    <!-- Primary meta -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle}>
    <meta name="description" content={description}>
    <meta name="author" content={siteName}>
    <link rel="canonical" href={canonicalURL}>

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="manifest" href="/manifest.webmanifest">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:title" content={siteTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:site_name" content={siteName}>
    <meta property="og:locale" content="en_US">
    <meta property="article:author" content={siteName}>

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content={canonicalURL}>
    <meta property="twitter:title" content={siteTitle}>
    <meta property="twitter:description" content={description}>

    <!-- Theme color -->
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    >
    <meta
      name="theme-color"
      content="#1d1f21"
      media="(prefers-color-scheme: dark)"
    >

    <!-- Sitemap + RSS -->
    <link rel="sitemap" href="/sitemap.xml">
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href="/rss.xml"
    >

    <!-- Analytics (via Partytown) — only rendered when analytics.enabled is true -->
    {siteConfig.analytics.enabled && siteConfig.analytics.url && (
            <script
                is:inline
                defer
                type="text/partytown"
                data-domain={siteConfig.analytics.domain}
                src={siteConfig.analytics.url}
            />
        )}

    <ClientRouter />
    <script is:inline>
      (() => {
        try {
          const storedTheme = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle(
            "dark",
            storedTheme === "dark" || (storedTheme !== "light" && prefersDark),
          );
        } catch {
          document.documentElement.classList.toggle(
            "dark",
            window.matchMedia("(prefers-color-scheme: dark)").matches,
          );
        }
      })();
    </script>
  </head>
  <body class="min-h-svh bg-background text-foreground antialiased">
    {!standalone && <Search />}

    {!standalone && <aside id="site-sidebar" class="sidebar" data-side="left">
      <nav>
        <section class="scrollbar">
          <!-- Search trigger -->
          <div class="px-2 pt-2">
            <button
              id="search-trigger"
              type="button"
              aria-label="Search"
              class="flex w-full items-center gap-2 rounded-md h-8 px-2 text-sm text-muted-foreground bg-sidebar-accent/60 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground border border-sidebar-border transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
              <span class="flex-1 text-left text-xs">Search...</span>
              <span class="kbd hidden sm:inline-flex">
                <span>⌘</span><span>K</span>
              </span>
            </button>
          </div>

          <div role="group">
            <ul>
              {primaryNav.map((item) => (
                                <li>
                                    <a
                                        href={item.href}
                                        target={item.target}
                                        rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
                                        aria-current={isActive(item.href) ? "page" : undefined}
                                    >
                                        <SidebarNavigationIcon
                                            href={item.href}
                                            icon={pageNavigationIcons.get(item.href)}
                                        />
                                        <span>{item.label}</span>
                                    </a>
                                </li>
                            ))}
            </ul>
          </div>
        </section>

        <footer>
          <!-- User profile popover — avatar trigger at bottom of sidebar -->
          <div class="popover w-full" data-keep-mobile-sidebar-open>
            <button
              type="button"
              aria-expanded="false"
              aria-controls="user-popover"
              data-keep-mobile-sidebar-open
              class="flex w-full items-center gap-3 rounded-md p-2 text-left text-sm outline-none ring-sidebar-ring hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 transition-colors h-12"
            >
              <!-- Avatar -->
              <script is:inline>
                window.addEventListener("error", (event) => {
                  const avatar = event.target;
                  if (avatar instanceof HTMLImageElement && avatar.id === "sidebar-avatar") {
                    avatar.hidden = true;
                    avatar.nextElementSibling?.removeAttribute("hidden");
                  }
                }, true);
              </script>
              <img
                id="sidebar-avatar"
                class="size-8 shrink-0 rounded-lg object-cover ring-1 ring-sidebar-border"
                src={cmsLogo ?? siteConfig.avatar}
                alt={siteName}
              >
              <div
                class="flex size-8 shrink-0 rounded-full bg-sidebar-accent text-sidebar-accent-foreground items-center justify-center text-sm font-semibold ring-1 ring-sidebar-border"
                hidden
              >
                {avatarInitial}
              </div>
              <!-- Identity -->
              <div class="grid flex-1 text-left leading-tight min-w-0">
                <span
                  class="truncate text-sm font-semibold text-sidebar-foreground"
                  >{siteName}</span
                >
                <span class="truncate text-xs text-muted-foreground"
                  >{siteTagline}</span
                >
              </div>
              <!-- Chevron up indicator -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 text-muted-foreground"
                aria-hidden="true"
              >
                <path d="m18 15-6-6-6 6"></path>
              </svg>
            </button>

            <!-- Popover panel — opens upward -->
            <div
              id="user-popover"
              data-popover
              data-side="top"
              data-align="start"
              aria-hidden="true"
              class="w-56"
            >
              <!-- Social links -->
              <div class="py-1">
                {social.github && (
                                    <a
                                        href={social.github}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="flex items-center gap-2.5 px-3 py-2 text-sm rounded-sm hover:bg-accent hover:text-accent-foreground transition-colors"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="14"
                                            height="14"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="text-muted-foreground shrink-0"
                                            aria-hidden="true"
                                        >
                                            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                                            <path d="M9 18c-4.51 2-5-2-7-2"></path>
                                        </svg>
                                        GitHub
                                    </a>
                                )}
                {social.twitter && (
                                    <a
                                        href={social.twitter}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="flex items-center gap-2.5 px-3 py-2 text-sm rounded-sm hover:bg-accent hover:text-accent-foreground transition-colors"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="14"
                                            height="14"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="text-muted-foreground shrink-0"
                                            aria-hidden="true"
                                        >
                                            <path d="M4 4l11.733 16H20L8.267 4z"></path>
                                            <path d="M4 20L15.733 4"></path>
                                        </svg>
                                        X
                                    </a>
                                )}
                {social.linkedin && (
                                    <a
                                        href={social.linkedin}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="flex items-center gap-2.5 px-3 py-2 text-sm rounded-sm hover:bg-accent hover:text-accent-foreground transition-colors"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="14"
                                            height="14"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="text-muted-foreground shrink-0"
                                            aria-hidden="true"
                                        >
                                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                                            <rect width="4" height="12" x="2" y="9"></rect>
                                            <circle cx="4" cy="4" r="2"></circle>
                                        </svg>
                                        LinkedIn
                                    </a>
                                )}
                {social.email && (
                                    <a
                                        href={`mailto:${social.email}`}
                                        class="flex items-center gap-2.5 px-3 py-2 text-sm rounded-sm hover:bg-accent hover:text-accent-foreground transition-colors"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="14"
                                            height="14"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="text-muted-foreground shrink-0"
                                            aria-hidden="true"
                                        >
                                            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                                        </svg>
                                        Email
                                    </a>
                                )}
              </div>

              <!-- Divider + theme toggle -->
              <div class="border-t border-border py-1">
                <button
                  id="theme-toggle"
                  type="button"
                  aria-label="Switch to dark mode"
                  class="flex w-full items-center gap-2.5 px-3 py-2 text-sm rounded-sm hover:bg-accent hover:text-accent-foreground transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-muted-foreground shrink-0 hidden dark:block"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="4"></circle>
                    <path
                      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                    ></path>
                  </svg>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-muted-foreground shrink-0 block dark:hidden"
                    aria-hidden="true"
                  >
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                  </svg>
                  <span class="dark:hidden">Dark mode</span>
                  <span class="hidden dark:inline">Light mode</span>
                </button>
              </div>
            </div>
          </div>

        </footer>
      </nav>
    </aside>}

    <!-- Sibling of .sidebar — gets auto margin from basecoat sidebar CSS -->
    <div id="page-shell" class="flex flex-col min-h-svh">
      <!-- Mobile top bar -->
      {!standalone && <header
        class="flex items-center gap-3 px-4 h-14 border-b border-border shrink-0 md:hidden"
      >
        <button
          id="mobile-sidebar-trigger"
          type="button"
          aria-label="Open menu"
          aria-controls="site-sidebar"
          aria-expanded="false"
          class="inline-flex size-8 items-center justify-center rounded-md hover:bg-accent transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
        </button>
      </header>}

      <main class="flex-1 pb-16"><slot /></main>
    </div>

    <script>
      import "basecoat-css/basecoat";
      import "basecoat-css/popover";
      import "basecoat-css/sidebar";
      import type { TransitionBeforeSwapEvent } from "astro:transitions/client";

      // Transfer the dark class to the incoming document before the swap so the
      // theme never flashes. The new page's <html> is server-rendered without the
      // class; astro:before-swap lets us patch it before it hits the DOM.
      document.addEventListener("astro:before-swap", (e) => {
        const isDark = document.documentElement.classList.contains("dark");
        (
          e as TransitionBeforeSwapEvent
        ).newDocument.documentElement.classList.toggle("dark", isDark);
        // Basecoat's observer is disconnected when the body is swapped.
        window.basecoat?.stop();
        // Release scroll lock before the page swaps out.
        unlockScroll();
        document.getElementById("page-shell")?.removeAttribute("inert");
      });

      // iOS-compatible scroll lock: freeze the body at the current scroll position
      // using position:fixed so the page can't scroll behind the sidebar overlay.
      // This avoids overflow:hidden (breaks touch events on fixed elements in Safari)
      // and touchmove interception (suppresses taps with any finger movement).
      let savedScrollY = 0;
      let isScrollLocked = false;

      const lockScroll = () => {
        if (isScrollLocked) {
          return;
        }
        isScrollLocked = true;
        savedScrollY = window.scrollY;
        document.body.style.position = "fixed";
        document.body.style.top = `-${savedScrollY}px`;
        document.body.style.width = "100%";
      };

      const unlockScroll = () => {
        if (!isScrollLocked) {
          return;
        }
        isScrollLocked = false;
        document.body.style.removeProperty("position");
        document.body.style.removeProperty("top");
        document.body.style.removeProperty("width");
        window.scrollTo({ top: savedScrollY, behavior: "instant" });
      };

      // Basecoat initializes itself from DOMContentLoaded on the first load.
      // After a body swap, restore its components and MutationObserver here.
      let sidebarObserver: MutationObserver | null = null;
      let mobileSidebarWasOpen = false;
      let restoreSidebarTriggerOnClose = false;
      let firstLoad = true;

      const syncThemeToggle = () => {
        const themeToggle = document.getElementById("theme-toggle");
        if (!themeToggle) return;
        const isDark = document.documentElement.classList.contains("dark");
        themeToggle.setAttribute(
          "aria-label",
          isDark ? "Switch to light mode" : "Switch to dark mode",
        );
      };

      const syncMobileSidebar = () => {
        const sidebar = document.getElementById("site-sidebar");
        const trigger = document.getElementById("mobile-sidebar-trigger");
        const pageShell = document.getElementById("page-shell");
        if (!sidebar || !trigger || !pageShell) return;

        const isMobile = !window.matchMedia("(min-width: 768px)").matches;
        const isOpen = !sidebar.hasAttribute("inert");
        const isMobileOpen = isMobile && isOpen;

        trigger.setAttribute("aria-expanded", String(isOpen));
        trigger.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
        pageShell.toggleAttribute("inert", isMobileOpen);

        if (isMobileOpen) {
          lockScroll();
        } else {
          unlockScroll();
          if (mobileSidebarWasOpen && restoreSidebarTriggerOnClose) {
            const activeElement = document.activeElement;
            if (
              !activeElement ||
              activeElement === document.body ||
              sidebar.contains(activeElement)
            ) {
              trigger.focus();
            }
          }
          restoreSidebarTriggerOnClose = false;
        }

        mobileSidebarWasOpen = isMobileOpen;
      };

      const reconcileSidebar = () => {
        const isDesktop = window.matchMedia("(min-width: 768px)").matches;

        // Let Basecoat update its own state when the viewport crosses the
        // breakpoint, rather than changing inert/aria-hidden behind its back.
        const sidebar = document.getElementById("site-sidebar");
        if (sidebar) {
          document.dispatchEvent(
            new CustomEvent("basecoat:sidebar", {
              detail: {
                id: sidebar.id,
                action: isDesktop ? "open" : "close",
              },
            }),
          );
        }

        syncMobileSidebar();
      };

      const initPage = () => {
        if (firstLoad) {
          firstLoad = false;
        } else {
          window.basecoat?.initAll();
          window.basecoat?.start();
        }

        syncThemeToggle();

        // Keep the mobile drawer's Basecoat state aligned with its trigger,
        // background inertness, focus restoration, and scroll lock.
        sidebarObserver?.disconnect();
        mobileSidebarWasOpen = false;
        restoreSidebarTriggerOnClose = false;
        const sidebar = document.getElementById("site-sidebar");
        if (sidebar) {
          sidebarObserver = new MutationObserver(syncMobileSidebar);
          sidebarObserver.observe(sidebar, {
            attributes: true,
            attributeFilter: ["inert"],
          });
        }

        reconcileSidebar();
      };

      document.addEventListener("astro:page-load", initPage);

      // Replace the previous registration if this script is evaluated again
      // during an Astro View Transition.
      type SidebarMediaQueryRegistration = {
        mediaQuery: MediaQueryList;
        listener: (event: MediaQueryListEvent) => void;
        cleanup: () => void;
      };
      const windowWithSidebarListener = window as Window & {
        __minastroSidebarMediaQuery?: SidebarMediaQueryRegistration;
      };
      windowWithSidebarListener.__minastroSidebarMediaQuery?.cleanup();

      const sidebarMediaQuery = window.matchMedia("(min-width: 768px)");
      const sidebarMediaQueryListener = () => reconcileSidebar();
      sidebarMediaQuery.addEventListener("change", sidebarMediaQueryListener);
      windowWithSidebarListener.__minastroSidebarMediaQuery = {
        mediaQuery: sidebarMediaQuery,
        listener: sidebarMediaQueryListener,
        cleanup: () =>
          sidebarMediaQuery.removeEventListener(
            "change",
            sidebarMediaQueryListener,
          ),
      };

      // Use event delegation on document so listeners survive body swaps.
      document.addEventListener("click", (e) => {
        const target = e.target as Element;

        if (target.closest("#theme-toggle")) {
          const isDark = !document.documentElement.classList.contains("dark");
          document.documentElement.classList.toggle("dark", isDark);
          syncThemeToggle();
          try {
            localStorage.setItem("theme", isDark ? "dark" : "light");
          } catch {
            // The class still applies for this session when storage is unavailable.
          }
        }

        if (target.closest("#mobile-sidebar-trigger")) {
          const sidebar = document.getElementById("site-sidebar");
          if (!sidebar) return;
          restoreSidebarTriggerOnClose = true;
          document.dispatchEvent(
            new CustomEvent("basecoat:sidebar", {
              detail: { id: sidebar.id, action: "open" },
            }),
          );
          syncMobileSidebar();
          const firstControl = sidebar.querySelector<HTMLElement>(
            'button:not([disabled]), a[href], input:not([disabled]), [tabindex]:not([tabindex="-1"])',
          );
          firstControl?.focus();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        const sidebar = document.getElementById("site-sidebar");
        if (
          !sidebar ||
          window.matchMedia("(min-width: 768px)").matches ||
          sidebar.hasAttribute("inert")
        ) {
          return;
        }

        event.preventDefault();
        restoreSidebarTriggerOnClose = true;
        document.dispatchEvent(
          new CustomEvent("basecoat:sidebar", {
            detail: { id: sidebar.id, action: "close" },
          }),
        );
        syncMobileSidebar();
      });

      const copyText = async (text: string) => {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return;
        }

        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        try {
          if (!document.execCommand("copy")) {
            throw new Error("Copy command failed");
          }
        } finally {
          textarea.remove();
        }
      };

      const enhanceCodeBlocks = () => {
        document
          .querySelectorAll("pre.astro-code:not([data-copy-enhanced]), pre.shiki:not([data-copy-enhanced])")
          .forEach((pre) => {
            pre.setAttribute("data-copy-enhanced", "true");

            const existingWrapper = pre.closest(".code-block") as HTMLElement | null;
            const wrapper = existingWrapper ?? document.createElement("div");
            if (!existingWrapper) {
              wrapper.className = "code-block";
              pre.parentNode?.insertBefore(wrapper, pre);
              wrapper.appendChild(pre);
            }

            if (wrapper.querySelector(".code-block__copy")) return;

            const button = document.createElement("button");
            button.type = "button";
            button.className = "code-block__copy";
            button.setAttribute("aria-label", "Copy code");

            const copyIcon = document.createElementNS(
              "http://www.w3.org/2000/svg",
              "svg",
            );
            copyIcon.setAttribute("viewBox", "0 0 24 24");
            copyIcon.setAttribute("class", "code-block__icon code-block__icon--copy");
            copyIcon.setAttribute("aria-hidden", "true");
            copyIcon.setAttribute("focusable", "false");
            copyIcon.innerHTML =
              '<rect width="13" height="13" x="8" y="8" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>';
            button.appendChild(copyIcon);

            const successIcon = document.createElementNS(
              "http://www.w3.org/2000/svg",
              "svg",
            );
            successIcon.setAttribute("viewBox", "0 0 24 24");
            successIcon.setAttribute("class", "code-block__icon code-block__icon--success");
            successIcon.setAttribute("aria-hidden", "true");
            successIcon.setAttribute("focusable", "false");
            successIcon.innerHTML =
              '<path d="m5 12 4 4L19 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>';
            button.appendChild(successIcon);

            const errorIcon = document.createElementNS(
              "http://www.w3.org/2000/svg",
              "svg",
            );
            errorIcon.setAttribute("viewBox", "0 0 24 24");
            errorIcon.setAttribute("class", "code-block__icon code-block__icon--error");
            errorIcon.setAttribute("aria-hidden", "true");
            errorIcon.setAttribute("focusable", "false");
            errorIcon.innerHTML =
              '<path d="M7 7l10 10M17 7 7 17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>';
            button.appendChild(errorIcon);

            const status = document.createElement("span");
            status.className = "code-block__status";
            status.setAttribute("role", "status");
            status.setAttribute("aria-live", "polite");

            button.addEventListener("click", async () => {
              if (button.disabled) return;
              button.disabled = true;
              button.dataset.copyState = "pending";
              try {
                await copyText(
                  pre.querySelector("code")?.textContent ?? pre.textContent ?? "",
                );
                button.setAttribute("aria-label", "Code copied");
                button.dataset.copyState = "success";
                status.textContent = "Code copied to clipboard.";
              } catch {
                button.setAttribute("aria-label", "Copy code failed");
                button.dataset.copyState = "error";
                status.textContent =
                  "Copy failed. Select the code and copy it manually.";
              } finally {
                window.setTimeout(() => {
                  button.disabled = false;
                  button.setAttribute("aria-label", "Copy code");
                  delete button.dataset.copyState;
                }, 1800);
              }
            });

            wrapper.appendChild(button);
            wrapper.appendChild(status);
          });
      };

      document.addEventListener("astro:page-load", enhanceCodeBlocks);
    </script>
  </body>
</html>
