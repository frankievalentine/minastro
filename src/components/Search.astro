<!-- Search dialog using the basecoat command-dialog pattern and EmDash runtime search. -->
<dialog
  id="search-dialog"
  class="command-dialog"
  aria-labelledby="search-dialog-title"
>
  <div class="command">
    <header>
      <h2 id="search-dialog-title" class="sr-only">Search pages and posts</h2>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Search pages and posts"
        aria-label="Search pages and posts"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        aria-autocomplete="list"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-menu"
      >
    </header>
    <div
      role="menu"
      id="search-menu"
      class="scrollbar"
      aria-label="Search results"
      aria-busy="false"
    >
      <p id="search-message" class="px-3 py-8 text-center text-sm text-muted-foreground">
        Start typing to search.
      </p>
    </div>
    <p id="search-status" class="sr-only" role="status" aria-live="polite"></p>
  </div>
</dialog>

<style is:global>
  @reference "../styles/global.css";

  #search-dialog [role="menu"] {
    min-height: 4.5rem;
  }

  #search-dialog [role="menuitem"] {
    @apply h-auto items-start whitespace-normal overflow-visible;
  }

  #search-dialog mark {
    @apply rounded-sm bg-primary/15 px-0.5 text-foreground;
  }
</style>

<script>
  interface SearchResult {
    collection: string;
    id: string;
    slug: string | null;
    locale: string;
    title?: string;
    snippet?: string;
    score: number;
  }

  interface SearchResponse {
    success: boolean;
    data?: { items: SearchResult[]; nextCursor?: string };
    error?: { code: string; message: string };
  }

  const getDialog = () =>
    document.getElementById("search-dialog") as HTMLDialogElement | null;
  const getInput = () =>
    document.getElementById("search-input") as HTMLInputElement | null;
  const getMenu = () => document.getElementById("search-menu");
  const getStatus = () => document.getElementById("search-status");

  let debounceTimer: number | undefined;
  let abortController: AbortController | undefined;
  let lastTrigger: HTMLElement | null = null;

  const setMessage = (message: string) => {
    const menu = getMenu();
    if (!menu) return;
    menu.innerHTML = `<p id="search-message" class="px-3 py-8 text-center text-sm text-muted-foreground">${message}</p>`;
  };

  const resultUrl = (result: SearchResult) => {
    if (!result.slug || !["posts", "projects"].includes(result.collection)) return null;
    return `/${result.collection}/${encodeURIComponent(result.slug)}`;
  };

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    })[character] || character);

  const renderResults = (items: SearchResult[]) => {
    const menu = getMenu();
    const status = getStatus();
    if (!menu) return;
    if (items.length === 0) {
      setMessage("No results found.");
      if (status) status.textContent = "No results found.";
      return;
    }

    menu.innerHTML = items
      .map((result) => {
        const href = resultUrl(result);
        if (!href) return "";
        const title = escapeHtml(result.title || "Untitled result");
        const collection = escapeHtml(result.collection);
        const snippet = result.snippet
          ? `<span class="mt-1 line-clamp-2 text-xs text-muted-foreground">${result.snippet}</span>`
          : "";
        return `<a role="menuitem" href="${href}" class="block px-3 py-2.5 outline-none transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground">
          <span class="block truncate text-sm font-medium">${title}</span>
          <span class="mt-0.5 block text-[0.6875rem] uppercase tracking-wide text-muted-foreground">${collection}</span>
          ${snippet}
        </a>`;
      })
      .join("");
    if (status) status.textContent = `${items.length} result${items.length === 1 ? "" : "s"} found.`;
  };

  const search = async (rawQuery: string) => {
    const query = rawQuery.trim();
    const menu = getMenu();
    const status = getStatus();
    if (!menu) return;
    abortController?.abort();
    if (query.length < 2) {
      menu.setAttribute("aria-busy", "false");
      setMessage(query ? "Keep typing to search." : "Start typing to search.");
      if (status) status.textContent = "";
      return;
    }

    abortController = new AbortController();
    menu.setAttribute("aria-busy", "true");
    setMessage("Searching…");
    if (status) status.textContent = "Searching…";
    try {
      const params = new URLSearchParams({ q: query, collections: "posts,projects", limit: "8" });
      const response = await fetch(`/_emdash/api/search?${params}`, {
        signal: abortController.signal,
        headers: { Accept: "application/json" },
      });
      const payload = (await response.json()) as SearchResponse;
      if (!response.ok || !payload.success || !payload.data) {
        throw new Error(payload.error?.message || "Search is temporarily unavailable.");
      }
      renderResults(payload.data.items);
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") return;
      setMessage("Search is temporarily unavailable. Please try again.");
      if (status) status.textContent = "Search is temporarily unavailable.";
    } finally {
      menu.setAttribute("aria-busy", "false");
    }
  };

  const handleInput = (event: Event) => {
    window.clearTimeout(debounceTimer);
    const input = event.currentTarget as HTMLInputElement;
    debounceTimer = window.setTimeout(() => search(input.value), 250);
  };

  const openDialog = (trigger?: HTMLElement | null) => {
    const dialog = getDialog();
    const input = getInput();
    if (!dialog) return;
    lastTrigger = trigger || lastTrigger;
    if (!dialog.open) dialog.showModal();
    input?.focus();
  };

  const closeDialog = () => getDialog()?.close();

  // CMD+K / CTRL+K — on document so it survives body swaps
  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      const dialog = getDialog();
      if (dialog?.open) {
        closeDialog();
      } else {
        openDialog();
      }
    }
  });

  document.addEventListener("input", (e) => {
    if ((e.target as Element | null)?.id === "search-input") handleInput(e);
  });

  document.addEventListener("click", (e) => {
    const target = e.target as Element | null;
    if (target?.closest("#search-trigger")) {
      lastTrigger = target.closest("#search-trigger") as HTMLElement;
      openDialog(lastTrigger);
    }
  });

  const attachDialogEvents = () => {
    const dialog = getDialog();
    if (!dialog || dialog.dataset.searchEventsAttached) return;
    dialog.dataset.searchEventsAttached = "true";
    dialog.addEventListener("close", () => {
      abortController?.abort();
      window.clearTimeout(debounceTimer);
      if (lastTrigger?.isConnected) lastTrigger.focus();
    });
  };

  attachDialogEvents();
  document.addEventListener("astro:page-load", attachDialogEvents);

  // Close on backdrop click (click target is the dialog element itself when clicking outside content)
  document.addEventListener("click", (e) => {
    const dialog = getDialog();
    if (dialog && e.target === dialog) {
      closeDialog();
    }
  });

  // Close the dialog before navigating so it doesn't animate open during the transition
  document.addEventListener("astro:before-preparation", () => {
    getDialog()?.close();
  });
</script>
