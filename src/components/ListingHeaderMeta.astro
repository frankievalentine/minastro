---
type ListingHeaderIcon =
  | "posts"
  | "projects"
  | "book"
  | "briefcase"
  | "file"
  | "folder"
  | "code"
  | "lightbulb";

interface Props {
  label?: string;
  icon?: string;
}

const { label, icon } = Astro.props;
const iconKeys = new Set<ListingHeaderIcon>([
  "posts",
  "projects",
  "book",
  "briefcase",
  "file",
  "folder",
  "code",
  "lightbulb",
]);
const normalizedLabel = typeof label === "string" && label.trim() ? label.trim() : undefined;
const normalizedIcon = typeof icon === "string" && iconKeys.has(icon as ListingHeaderIcon)
  ? icon as ListingHeaderIcon
  : undefined;
---

{(normalizedLabel || normalizedIcon) && (
  <div class="mb-3 flex items-center gap-2">
    {normalizedIcon && (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-muted-foreground"
        aria-hidden="true"
        focusable="false"
      >
        {normalizedIcon === "posts" && (
          <>
            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
            <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
            <path d="M10 9H8"></path>
            <path d="M16 13H8"></path>
            <path d="M16 17H8"></path>
          </>
        )}
        {normalizedIcon === "projects" && (
          <>
            <path d="M3 3h7v7H3z"></path>
            <path d="M14 3h7v7h-7z"></path>
            <path d="M14 14h7v7h-7z"></path>
            <path d="M3 14h7v7H3z"></path>
          </>
        )}
        {normalizedIcon === "book" && (
          <>
            <path d="M2 4.5A2.5 2.5 0 0 1 4.5 2H9a3 3 0 0 1 3 3v17a3 3 0 0 0-3-3H4.5A2.5 2.5 0 0 0 2 21.5z"></path>
            <path d="M22 4.5A2.5 2.5 0 0 0 19.5 2H15a3 3 0 0 0-3 3v17a3 3 0 0 1 3-3h4.5a2.5 2.5 0 0 1 2.5 2.5z"></path>
          </>
        )}
        {normalizedIcon === "briefcase" && (
          <>
            <rect width="20" height="14" x="2" y="7" rx="2"></rect>
            <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            <path d="M12 12v.01"></path>
            <path d="M2 12a18 18 0 0 0 20 0"></path>
          </>
        )}
        {normalizedIcon === "file" && (
          <>
            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
            <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
          </>
        )}
        {normalizedIcon === "folder" && <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>}
        {normalizedIcon === "code" && (
          <>
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </>
        )}
        {normalizedIcon === "lightbulb" && (
          <>
            <path d="M9 18h6"></path>
            <path d="M10 22h4"></path>
            <path d="M15.09 14c.18-.58.91-1.34 1.35-1.83A7 7 0 1 0 7.56 12.17c.44.49 1.17 1.25 1.35 1.83"></path>
          </>
        )}
      </svg>
    )}
    {normalizedLabel && (
      <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
        {normalizedLabel}
      </span>
    )}
  </div>
)}
