---
import { getEmDashCollection } from "emdash";
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../site.config";

const defaultCopy = {
  eyebrow: "Newsletter",
  title: "Stay in the loop",
  description: "Occasional notes on engineering, projects, and ideas. No spam.",
  signupTitle: "Subscribe for new notes",
  signupDescription: "Get new writing and project updates in your inbox when there is something useful to share.",
  nameLabel: "Name",
  nameOptionalLabel: "(optional)",
  namePlaceholder: "Your name",
  emailLabel: "Email address",
  emailPlaceholder: "you@example.com",
  emailHelp: "You can unsubscribe from any email.",
  submitLabel: "Subscribe",
  submittingLabel: "Subscribing…",
  consentCopy: "By subscribing, you consent to receive this newsletter. Your email is used only for newsletter communications and can be removed at any time.",
  successTitle: "Check your inbox",
  successMessage: "If this address can be subscribed, you will receive a confirmation email shortly. Use the link there to finish subscribing.",
  disabledHeading: "Newsletter coming soon",
  disabledBody: "Signup is not open yet. Check back here for future updates.",
  expectationsTitle: "What to expect",
  expectationOneTitle: "Engineering notes",
  expectationOneDescription: "Practical notes on building, debugging, and maintaining software.",
  expectationTwoTitle: "Project updates",
  expectationTwoDescription: "Short updates on open-source work, experiments, and useful tools.",
  expectationThreeTitle: "A focused pace",
  expectationThreeDescription: "Occasional delivery, only when there is something worth sending.",
};

const newsletterPageResult = await getEmDashCollection("newsletter_page", {
  status: "published",
});

if (newsletterPageResult.error) {
  throw newsletterPageResult.error;
}

const newsletterPage = newsletterPageResult.entries.find(({ id, data }) =>
  id === "newsletter" || data.slug === "newsletter" || data.id === "newsletter"
)?.data;
const normalizedString = (value: unknown): string | undefined =>
  typeof value === "string" && value.trim() ? value.trim() : undefined;
const requiredNewsletterFields = [
  "title",
  "description",
  "signup_title",
  "signup_description",
  "name_label",
  "email_label",
  "submit_label",
  "submitting_label",
  "consent_copy",
  "success_title",
  "success_message",
  "disabled_heading",
  "disabled_body",
  "expectations_title",
  "expectation_one_title",
  "expectation_one_description",
  "expectation_two_title",
  "expectation_two_description",
  "expectation_three_title",
  "expectation_three_description",
] as const;

if (newsletterPage) {
  const invalidFields = requiredNewsletterFields.filter(
    (field) => !normalizedString(newsletterPage[field]),
  );
  if (invalidFields.length > 0) {
    throw new Error(
      `The CMS newsletter record has missing or empty required fields: ${invalidFields.join(", ")}.`,
    );
  }
}

const requiredCmsString = (value: unknown): string => {
  const normalized = normalizedString(value);
  if (!normalized) throw new Error("A required newsletter CMS field is empty.");
  return normalized;
};
const copy = newsletterPage ? {
  eyebrow: normalizedString(newsletterPage.eyebrow),
  title: requiredCmsString(newsletterPage.title),
  description: requiredCmsString(newsletterPage.description),
  signupTitle: requiredCmsString(newsletterPage.signup_title),
  signupDescription: requiredCmsString(newsletterPage.signup_description),
  nameLabel: requiredCmsString(newsletterPage.name_label),
  nameOptionalLabel: normalizedString(newsletterPage.name_optional_label),
  namePlaceholder: normalizedString(newsletterPage.name_placeholder),
  emailLabel: requiredCmsString(newsletterPage.email_label),
  emailPlaceholder: normalizedString(newsletterPage.email_placeholder),
  emailHelp: normalizedString(newsletterPage.email_help),
  submitLabel: requiredCmsString(newsletterPage.submit_label),
  submittingLabel: requiredCmsString(newsletterPage.submitting_label),
  consentCopy: requiredCmsString(newsletterPage.consent_copy),
  successTitle: requiredCmsString(newsletterPage.success_title),
  successMessage: requiredCmsString(newsletterPage.success_message),
  disabledHeading: requiredCmsString(newsletterPage.disabled_heading),
  disabledBody: requiredCmsString(newsletterPage.disabled_body),
  expectationsTitle: requiredCmsString(newsletterPage.expectations_title),
  expectationOneTitle: requiredCmsString(newsletterPage.expectation_one_title),
  expectationOneDescription: requiredCmsString(newsletterPage.expectation_one_description),
  expectationTwoTitle: requiredCmsString(newsletterPage.expectation_two_title),
  expectationTwoDescription: requiredCmsString(newsletterPage.expectation_two_description),
  expectationThreeTitle: requiredCmsString(newsletterPage.expectation_three_title),
  expectationThreeDescription: requiredCmsString(newsletterPage.expectation_three_description),
} : defaultCopy;

const enabled = siteConfig.newsletter.enabled;

const newsletterConfig = siteConfig.newsletter as typeof siteConfig.newsletter & {
  turnstileSiteKey?: string;
  turnstile?: { siteKey?: string };
};
const turnstileSiteKey =
  newsletterConfig.turnstileSiteKey ?? newsletterConfig.turnstile?.siteKey;
const canSubmit = enabled && Boolean(turnstileSiteKey);
const emailDescribedBy = copy.emailHelp
  ? "newsletter-email-help newsletter-error"
  : "newsletter-error";
---

<Layout title={copy.eyebrow ?? copy.title} currentPage="/newsletter">
  <div class="mx-auto w-full max-w-lg px-6 py-12 md:py-16">
    <header class="mb-8 text-center">
      {copy.eyebrow && (
        <div class="mb-3 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          {copy.eyebrow}
        </div>
      )}
      <h1 class="text-2xl font-bold tracking-tight text-foreground">{copy.title}</h1>
      <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted-foreground">{copy.description}</p>
    </header>

    {!enabled ? (
      <section aria-labelledby="newsletter-unavailable-heading" class="card text-center">
        <header>
          <h2 id="newsletter-unavailable-heading">{copy.disabledHeading}</h2>
          <p>{copy.disabledBody}</p>
        </header>
      </section>
    ) : (
      <>
        {!turnstileSiteKey && (
          <div class="mb-4 rounded-md border border-border bg-muted/40 px-3 py-2 text-sm text-muted-foreground" role="status">
            <strong class="font-semibold text-foreground">Signup is not configured.</strong> Add the Turnstile site key before collecting subscribers.
          </div>
        )}

        <section aria-labelledby="signup-heading" class="card">
          <header>
            <h2 id="signup-heading">{copy.signupTitle}</h2>
            <p>{copy.signupDescription}</p>
          </header>
          <section>
            <form id="newsletter-form" class="grid gap-4" novalidate>
              <div class="grid gap-2">
                <label for="newsletter-name" class="label">
                  {copy.nameLabel}
                  {copy.nameOptionalLabel && <span class="font-normal text-muted-foreground"> {copy.nameOptionalLabel}</span>}
                </label>
                <input id="newsletter-name" name="name" class="input disabled:cursor-not-allowed disabled:opacity-60" type="text" autocomplete="given-name" placeholder={copy.namePlaceholder} disabled={!canSubmit} />
              </div>
              <div class="grid gap-2">
                <label for="newsletter-email" class="label">{copy.emailLabel} <span class="text-destructive" aria-hidden="true">*</span></label>
                <input id="newsletter-email" name="email" class="input disabled:cursor-not-allowed disabled:opacity-60" type="email" autocomplete="email" placeholder={copy.emailPlaceholder} required disabled={!canSubmit} aria-describedby={emailDescribedBy} />
                {copy.emailHelp && <p id="newsletter-email-help" class="text-xs text-muted-foreground">{copy.emailHelp}</p>}
              </div>
              {turnstileSiteKey && <div id="newsletter-turnstile" class="min-h-[65px]" data-sitekey={turnstileSiteKey}></div>}
              <p id="newsletter-error" class="text-sm text-destructive" role="alert" hidden></p>
              <button type="submit" class="btn w-full" id="newsletter-submit" disabled={!canSubmit} data-submit-label={copy.submitLabel} data-submitting-label={copy.submittingLabel}>
                <span class="newsletter-submit-label">{copy.submitLabel}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
              </button>
              <p class="text-center text-xs leading-relaxed text-muted-foreground">{copy.consentCopy}</p>
            </form>
            <div id="newsletter-success" class="py-4 text-center" role="status" tabindex="-1" hidden>
              <div class="mx-auto mb-3 inline-flex size-9 items-center justify-center rounded-full bg-secondary" aria-hidden="true">✓</div>
              <h2 class="mb-1 font-semibold">{copy.successTitle}</h2>
              <p class="text-sm text-muted-foreground">{copy.successMessage}</p>
            </div>
          </section>
        </section>

        <section aria-labelledby="expect-heading" class="card mt-4">
          <header>
            <h2 id="expect-heading">{copy.expectationsTitle}</h2>
          </header>
          <section>
            <ul class="grid gap-4">
              <li class="flex gap-3">
                <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-secondary text-secondary-foreground" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"></path></svg></span>
                <div><h3 class="text-sm font-medium text-foreground">{copy.expectationOneTitle}</h3><p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">{copy.expectationOneDescription}</p></div>
              </li>
              <li class="flex gap-3">
                <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-secondary text-secondary-foreground" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h7v7H3z"></path><path d="M14 3h7v7h-7z"></path><path d="M14 14h7v7h-7z"></path><path d="M3 14h7v7H3z"></path></svg></span>
                <div><h3 class="text-sm font-medium text-foreground">{copy.expectationTwoTitle}</h3><p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">{copy.expectationTwoDescription}</p></div>
              </li>
              <li class="flex gap-3">
                <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-secondary text-secondary-foreground" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>
                <div><h3 class="text-sm font-medium text-foreground">{copy.expectationThreeTitle}</h3><p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">{copy.expectationThreeDescription}</p></div>
              </li>
            </ul>
          </section>
        </section>
      </>
    )}
  </div>
</Layout>

{enabled && turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}

<script>
  type NewsletterResponse = { success: boolean; error?: string };
  type Turnstile = { render: (container: HTMLElement, options: { sitekey: string; action: string }) => string | number; getResponse: (widgetId: string | number) => string; reset: (widgetId: string | number) => void };
  const isNewsletterResponse = (value: unknown): value is NewsletterResponse => typeof value === "object" && value !== null && "success" in value && typeof value.success === "boolean" && (!("error" in value) || typeof value.error === "string");
  const getTurnstile = () => (window as Window & { turnstile?: Turnstile }).turnstile;
  let turnstileWidgetId: string | number | null = null;
  let turnstileContainerForWidget: HTMLElement | null = null;

  const initTurnstile = (turnstileContainer: HTMLElement) => {
    if (turnstileContainerForWidget !== turnstileContainer) {
      turnstileContainerForWidget = turnstileContainer;
      turnstileWidgetId = null;
    }
    const renderTurnstile = () => {
      const turnstile = getTurnstile();
      if (turnstile && turnstileWidgetId === null && turnstileContainer.isConnected) {
        turnstileWidgetId = turnstile.render(turnstileContainer, { sitekey: turnstileContainer.dataset.sitekey ?? "", action: "newsletter_subscribe" });
      }
    };
    if (getTurnstile()) {
      renderTurnstile();
      return;
    }
    if (turnstileContainer.dataset.turnstileLoadListener !== "true") {
      const script = document.querySelector('script[src^="https://challenges.cloudflare.com/turnstile/v0/api.js"]');
      if (script) {
        turnstileContainer.dataset.turnstileLoadListener = "true";
        script.addEventListener("load", renderTurnstile, { once: true });
      }
    }
  };

  const init = () => {
    const form = document.querySelector("#newsletter-form") as HTMLFormElement | null;
    const email = document.querySelector("#newsletter-email") as HTMLInputElement | null;
    const name = document.querySelector("#newsletter-name") as HTMLInputElement | null;
    const submit = document.querySelector("#newsletter-submit") as HTMLButtonElement | null;
    const error = document.querySelector("#newsletter-error") as HTMLElement | null;
    const success = document.querySelector("#newsletter-success") as HTMLElement | null;
    const turnstileContainer = document.querySelector("#newsletter-turnstile") as HTMLElement | null;
    if (!form || !email || !submit || !error || !success || !turnstileContainer) return;
    const submitLabel = submit.dataset.submitLabel ?? "Subscribe";
    const submittingLabel = submit.dataset.submittingLabel ?? "Subscribing…";
    initTurnstile(turnstileContainer);
    if (form.dataset.initialized === "true") return;
    form.dataset.initialized = "true";
    const showError = (message: string) => { error.textContent = message; error.hidden = false; };
    const setSubmitLabel = (label: string) => submit.querySelector(".newsletter-submit-label")?.replaceChildren(label);
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!email.checkValidity()) {
        showError(email.validationMessage || "Enter a valid email address.");
        email.setAttribute("aria-invalid", "true");
        email.focus();
        return;
      }
      error.hidden = true;
      submit.disabled = true;
      setSubmitLabel(submittingLabel);
      const currentTurnstile = getTurnstile();
      const turnstileToken = currentTurnstile && turnstileWidgetId !== null ? currentTurnstile.getResponse(turnstileWidgetId) : undefined;
      try {
        const response = await fetch("/api/newsletter/subscribe", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: email.value.trim(), name: name?.value.trim() || undefined, turnstileToken: turnstileToken || undefined }) });
        const body: unknown = await response.json().catch(() => null);
        if (!response.ok || !isNewsletterResponse(body) || !body.success) throw new Error("Unable to subscribe. Please try again.");
        form.hidden = true;
        success.hidden = false;
        success.focus();
      } catch (requestError) {
        showError(requestError instanceof Error ? requestError.message : "Unable to subscribe. Please try again.");
        submit.disabled = false;
        setSubmitLabel(submitLabel);
      } finally {
        if (currentTurnstile && turnstileWidgetId !== null) currentTurnstile.reset(turnstileWidgetId);
      }
    });
    email.addEventListener("input", () => { email.removeAttribute("aria-invalid"); error.hidden = true; });
  };
  document.addEventListener("astro:page-load", init);
  init();
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    #newsletter-submit { transition: transform 150ms ease, opacity 150ms ease; }
    #newsletter-submit:active { transform: scale(0.96); }
  }
</style>
