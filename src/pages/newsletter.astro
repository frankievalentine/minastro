---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../site.config";

const enabled = siteConfig.newsletter.enabled;

const newsletterConfig = siteConfig.newsletter as typeof siteConfig.newsletter & {
  turnstileSiteKey?: string;
  turnstile?: { siteKey?: string };
};
const turnstileSiteKey =
  newsletterConfig.turnstileSiteKey ?? newsletterConfig.turnstile?.siteKey;
const canSubmit = enabled && Boolean(turnstileSiteKey);
---

<Layout title="Newsletter" currentPage="/newsletter">
  <div class="mx-auto w-full max-w-lg px-6 py-12 md:py-16">
    <header class="mb-8 text-center">
      <div class="mb-3 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-muted-foreground">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
        Newsletter
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-foreground">Stay in the loop</h1>
      <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted-foreground">{siteConfig.newsletter.description ?? "Occasional notes on engineering, projects, and ideas."}</p>
    </header>

    {!enabled && (
      <div class="mb-4 rounded-md border border-destructive bg-destructive/5 px-3 py-2 text-sm text-destructive" role="status">
        <strong class="font-semibold">Production signup is disabled.</strong> Enable the newsletter integration before subscribers can be collected.
      </div>
    )}
    {enabled && !turnstileSiteKey && (
      <div class="mb-4 rounded-md border border-border bg-muted/40 px-3 py-2 text-sm text-muted-foreground" role="status">
        <strong class="font-semibold text-foreground">Signup is not configured.</strong> Add the Turnstile site key before collecting subscribers.
      </div>
    )}

    <section aria-labelledby="signup-heading" class="card">
      <header>
        <h2 id="signup-heading">Subscribe for new notes</h2>
        <p>Get new writing and project updates in your inbox when there is something useful to share.</p>
      </header>
      <section>
        <form id="newsletter-form" class="grid gap-4" novalidate>
          <div class="grid gap-2">
            <label for="newsletter-name" class="label">Name <span class="font-normal text-muted-foreground">(optional)</span></label>
            <input id="newsletter-name" name="name" class="input disabled:cursor-not-allowed disabled:opacity-60" type="text" autocomplete="given-name" placeholder="Your name" disabled={!canSubmit} />
          </div>
          <div class="grid gap-2">
            <label for="newsletter-email" class="label">Email address <span class="text-destructive" aria-hidden="true">*</span></label>
            <input id="newsletter-email" name="email" class="input disabled:cursor-not-allowed disabled:opacity-60" type="email" autocomplete="email" placeholder="you@example.com" required disabled={!canSubmit} aria-describedby="newsletter-email-help newsletter-error" />
            <p id="newsletter-email-help" class="text-xs text-muted-foreground">You can unsubscribe from any email.</p>
          </div>
          {enabled && turnstileSiteKey && <div id="newsletter-turnstile" class="min-h-[65px]" data-sitekey={turnstileSiteKey}></div>}
          <p id="newsletter-error" class="text-sm text-destructive" role="alert" hidden></p>
          <button type="submit" class="btn w-full" id="newsletter-submit" disabled={!canSubmit}>
            <span class="newsletter-submit-label">Subscribe</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
          </button>
          <p class="text-center text-xs leading-relaxed text-muted-foreground">By subscribing, you consent to receive this newsletter. Your email is used only for newsletter communications and can be removed at any time.</p>
        </form>
        <div id="newsletter-success" class="py-4 text-center" role="status" tabindex="-1" hidden>
          <div class="mx-auto mb-3 inline-flex size-9 items-center justify-center rounded-full bg-secondary" aria-hidden="true">✓</div>
          <h2 class="mb-1 font-semibold">Check your inbox</h2>
          <p class="text-sm text-muted-foreground">If this address can be subscribed, you will receive a confirmation email shortly. Use the link there to finish subscribing.</p>
        </div>
      </section>
    </section>

    <section aria-labelledby="expect-heading" class="card mt-4">
      <header>
        <h2 id="expect-heading">What to expect</h2>
      </header>
      <section>
        <ul class="grid gap-4">
          <li class="flex gap-3">
            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-secondary text-secondary-foreground" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"></path></svg></span>
            <div><h3 class="text-sm font-medium text-foreground">Engineering notes</h3><p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">Practical notes on building, debugging, and maintaining software.</p></div>
          </li>
          <li class="flex gap-3">
            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-secondary text-secondary-foreground" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h7v7H3z"></path><path d="M14 3h7v7h-7z"></path><path d="M14 14h7v7h-7z"></path><path d="M3 14h7v7H3z"></path></svg></span>
            <div><h3 class="text-sm font-medium text-foreground">Project updates</h3><p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">Short updates on open-source work, experiments, and useful tools.</p></div>
          </li>
          <li class="flex gap-3">
            <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-secondary text-secondary-foreground" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>
            <div><h3 class="text-sm font-medium text-foreground">A focused pace</h3><p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">Occasional delivery, only when there is something worth sending.</p></div>
          </li>
        </ul>
      </section>
    </section>
  </div>
</Layout>

{enabled && turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}

{enabled && turnstileSiteKey && <script>
  type NewsletterResponse = { success: boolean; error?: string };
  type Turnstile = { render: (container: HTMLElement, options: { sitekey: string; action: string }) => string | number; getResponse: (widgetId: string | number) => string; reset: (widgetId: string | number) => void };
  const isNewsletterResponse = (value: unknown): value is NewsletterResponse => typeof value === "object" && value !== null && "success" in value && typeof value.success === "boolean" && (!("error" in value) || typeof value.error === "string");
  const getTurnstile = () => (window as Window & { turnstile?: Turnstile }).turnstile;
  let turnstileWidgetId: string | number | null = null;
  let turnstileContainerForWidget: HTMLElement | null = null;

  const initTurnstile = (turnstileContainer: HTMLElement) => {
    if (turnstileContainerForWidget !== turnstileContainer) {
      turnstileContainerForWidget = turnstileContainer;
      turnstileWidgetId = null;
    }
    const renderTurnstile = () => {
      const turnstile = getTurnstile();
      if (turnstile && turnstileWidgetId === null && turnstileContainer.isConnected) {
        turnstileWidgetId = turnstile.render(turnstileContainer, { sitekey: turnstileContainer.dataset.sitekey ?? "", action: "newsletter_subscribe" });
      }
    };
    if (getTurnstile()) {
      renderTurnstile();
      return;
    }
    if (turnstileContainer.dataset.turnstileLoadListener !== "true") {
      const script = document.querySelector('script[src^="https://challenges.cloudflare.com/turnstile/v0/api.js"]');
      if (script) {
        turnstileContainer.dataset.turnstileLoadListener = "true";
        script.addEventListener("load", renderTurnstile, { once: true });
      }
    }
  };

  const init = () => {
    const form = document.querySelector("#newsletter-form") as HTMLFormElement | null;
    const email = document.querySelector("#newsletter-email") as HTMLInputElement | null;
    const name = document.querySelector("#newsletter-name") as HTMLInputElement | null;
    const submit = document.querySelector("#newsletter-submit") as HTMLButtonElement | null;
    const error = document.querySelector("#newsletter-error") as HTMLElement | null;
    const success = document.querySelector("#newsletter-success") as HTMLElement | null;
    const turnstileContainer = document.querySelector("#newsletter-turnstile") as HTMLElement | null;
    if (!form || !email || !submit || !error || !success || !turnstileContainer) return;
    initTurnstile(turnstileContainer);
    if (form.dataset.initialized === "true") return;
    form.dataset.initialized = "true";
    const showError = (message: string) => { error.textContent = message; error.hidden = false; };
    const setSubmitLabel = (label: string) => submit.querySelector(".newsletter-submit-label")?.replaceChildren(label);
    form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!email.checkValidity()) {
      email?.setAttribute("aria-invalid", "true");
      email?.focus();
      return;
    }
    error.hidden = true;
    if (!email.checkValidity()) {
      email.setAttribute("aria-invalid", "true");
      email.focus();
      return;
    }
    submit.disabled = true;
    setSubmitLabel("Subscribing…");
    const currentTurnstile = getTurnstile();
    const turnstileToken = currentTurnstile && turnstileWidgetId !== null ? currentTurnstile.getResponse(turnstileWidgetId) : undefined;
    try {
      const response = await fetch("/api/newsletter/subscribe", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: email.value.trim(), name: name?.value.trim() || undefined, turnstileToken: turnstileToken || undefined }) });
      const body: unknown = await response.json().catch(() => null);
      if (!response.ok || !isNewsletterResponse(body) || !body.success) throw new Error("Unable to subscribe. Please try again.");
      form.hidden = true;
      success.hidden = false;
      success.focus();
    } catch (requestError) {
      showError(requestError instanceof Error ? requestError.message : "Unable to subscribe. Please try again.");
      submit.disabled = false;
      setSubmitLabel("Subscribe");
    } finally {
      if (currentTurnstile && turnstileWidgetId !== null) currentTurnstile.reset(turnstileWidgetId);
    }
    });
    email.addEventListener("input", () => { email.removeAttribute("aria-invalid"); error.hidden = true; });
  };
  document.addEventListener("astro:page-load", init);
  init();
</script>}

<style>
  @media (prefers-reduced-motion: no-preference) {
    #newsletter-submit { transition: transform 150ms ease, opacity 150ms ease; }
    #newsletter-submit:active { transform: scale(0.96); }
  }
</style>
