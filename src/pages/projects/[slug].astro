---
export const prerender = false;

import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Layout from "../../layouts/Layout.astro";

const slug = Astro.params.slug;
if (!slug) {
  return new Response(null, { status: 404 });
}
const { entry: project, error, isPreview } = await getEmDashEntry("projects", slug);

if (error) {
  return new Response("Server error", { status: 500 });
}

if (!project) {
  return new Response(null, { status: 404 });
}

if (project.data.status !== "published" && !isPreview) {
  return new Response(null, { status: 404 });
}

const statusLabel: Record<string, string> = {
  active: "Active",
  wip: "WIP",
  archived: "Archived",
};
---

<Layout
  title={project.data.title}
  description={project.data.description}
  currentPage={`/projects/${project.data.slug}`}
>
  <div class="max-w-2xl mx-auto px-6 py-12 md:py-16">
    <!-- Back link -->
    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-8"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
      </svg>
      All projects
    </a>

    <!-- Project header -->
    <header class="mb-8">
      <div class="flex items-center gap-2 flex-wrap mb-3">
        <h1 class="text-3xl font-bold tracking-tight text-foreground leading-tight">
          {project.data.title}
        </h1>
        {project.data.projectStatus && (
          <span class="badge-secondary text-xs">
            {statusLabel[project.data.projectStatus] ?? project.data.projectStatus}
          </span>
        )}
      </div>
      <p class="text-muted-foreground leading-relaxed mb-4">
        {project.data.description}
      </p>

      <!-- Meta links -->
      <div class="flex items-center gap-4 flex-wrap">
        {project.data.github && (
          <a
            href={project.data.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
            Source
          </a>
        )}
        {project.data.url && (
          <a
            href={project.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 3h6v6"></path>
              <path d="M10 14 21 3"></path>
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            </svg>
            Visit site
          </a>
        )}
        {project.data.publishedAt && (
          <time
            datetime={project.data.publishedAt.toISOString()}
            class="text-sm text-muted-foreground"
          >
            {project.data.publishedAt.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        )}
      </div>

      {project.data.terms?.tag && project.data.terms.tag.length > 0 && (
        <div class="flex gap-1.5 flex-wrap mt-4">
          {project.data.terms.tag.map((tag) => (
            <span class="badge-outline text-xs">{tag.label ?? tag.name}</span>
          ))}
        </div>
      )}
    </header>

    {project.data.content && (
      <>
        <div role="separator" class="border-t border-border mb-8"></div>

        <!-- Project body -->
        <div class="prose prose-sm prose-neutral dark:prose-invert max-w-none">
          <PortableText value={project.data.content} />
        </div>
      </>
    )}

    <div role="separator" class="border-t border-border mt-12 mb-8"></div>

    <!-- Footer nav -->
    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
      </svg>
      Back to all projects
    </a>
  </div>
</Layout>

<style is:global>
  @reference "../../styles/global.css";

  .prose h2 {
    @apply text-xl font-semibold text-foreground mt-8 mb-3;
  }
  .prose h3 {
    @apply text-base font-semibold text-foreground mt-6 mb-2;
  }
  .prose p {
    @apply text-sm text-muted-foreground leading-relaxed mb-4;
  }
  .prose ul {
    @apply text-sm text-muted-foreground list-disc pl-5 mb-4 space-y-1;
  }
  .prose ol {
    @apply text-sm text-muted-foreground list-decimal pl-5 mb-4 space-y-1;
  }
  .prose strong {
    @apply font-semibold text-foreground;
  }
  .prose a {
    @apply text-foreground underline underline-offset-4 hover:text-muted-foreground transition-colors;
  }
  .prose blockquote {
    @apply border-l-2 border-border pl-4 italic text-muted-foreground;
  }

  .prose .expressive-code {
    @apply mb-4;
  }
  .prose .expressive-code pre {
    @apply text-xs;
  }
</style>
