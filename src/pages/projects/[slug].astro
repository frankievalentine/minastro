---
export const prerender = false;

import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import CodeBlock from "../../components/CodeBlock.astro";
import Layout from "../../layouts/Layout.astro";

const slug = Astro.params.slug;
if (!slug) {
  return new Response(null, { status: 404 });
}

interface ProjectTag {
  label: string;
  name: string;
}

interface ProjectData {
  title: string;
  description: string;
  slug: string;
  projectStatus: string;
  github?: string;
  url?: string;
  publishedAt?: Date;
  tags: ProjectTag[];
  featuredImage?: { src: string; alt: string };
}

const featuredImage = (value: unknown, alt: string) => {
  if (typeof value !== "object" || value === null) return undefined;
  const { src, alt: imageAlt } = value as { src?: unknown; alt?: unknown };
  if (typeof src !== "string" || !src.trim()) return undefined;
  return { src, alt: typeof imageAlt === "string" && imageAlt.trim() ? imageAlt : alt };
};

const statusLabel: Record<string, string> = {
  active: "Active",
  wip: "WIP",
  archived: "Archived",
};

const { entry, error, isPreview } = await getEmDashEntry("projects", slug);

if (error) {
  return new Response("Server error", { status: 500 });
}

if (!entry) {
  return new Response(null, { status: 404 });
}

if (entry.data.status !== "published" && !isPreview) {
  return new Response(null, { status: 404 });
}

const portableTextContent = entry.data.content ?? [];
const hasContent = portableTextContent.length > 0;
const projectStatus =
  (entry.data as { projectStatus?: string }).projectStatus ??
  (entry.data as { project_status?: string }).project_status ??
  "active";
const projectData: ProjectData = {
  title: entry.data.title,
  description: entry.data.description,
  slug: entry.data.slug ?? slug,
  projectStatus,
  github: entry.data.github,
  url: entry.data.url,
  publishedAt: entry.data.publishedAt ?? undefined,
  tags: (entry.data.terms?.tag ?? []).map((tag) => ({
    label: tag.label ?? tag.name,
    name: tag.name,
  })),
  featuredImage: featuredImage(entry.data.featured_image, entry.data.title),
};
---

<Layout
  title={projectData.title}
  description={projectData.description}
  currentPage={`/projects/${projectData.slug}`}
>
  <div class="max-w-2xl mx-auto px-6 py-12 md:py-16">
    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-8"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
      </svg>
      All projects
    </a>

    <header class="mb-8">
      <div class="flex items-center gap-2 flex-wrap mb-3">
        <h1 class="text-3xl font-bold tracking-tight text-foreground leading-tight">
          {projectData.title}
        </h1>
        <span class="badge text-xs" data-variant="secondary">
          {statusLabel[projectData.projectStatus] ?? projectData.projectStatus}
        </span>
      </div>
      <p class="text-muted-foreground leading-relaxed mb-4">
        {projectData.description}
      </p>
      {projectData.featuredImage && <img class="mb-4 aspect-[16/9] w-full rounded-md object-cover" src={projectData.featuredImage.src} alt={projectData.featuredImage.alt} />}

      <div class="flex items-center gap-4 flex-wrap">
        {projectData.github && (
          <a
            href={projectData.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
            Source
          </a>
        )}
        {projectData.url && (
          <a
            href={projectData.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 3h6v6"></path>
              <path d="M10 14 21 3"></path>
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            </svg>
            Visit site
          </a>
        )}
        {projectData.publishedAt && (
          <time
            datetime={projectData.publishedAt.toISOString()}
            class="text-sm text-muted-foreground"
          >
            {projectData.publishedAt.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        )}
      </div>

      {projectData.tags.length > 0 && (
        <div class="flex gap-1.5 flex-wrap mt-4">
          {projectData.tags.map((tag) => (
            <span class="badge text-xs" data-variant="outline">{tag.label}</span>
          ))}
        </div>
      )}
    </header>

    {hasContent && (
      <>
        <hr class="border-0 border-t border-border mb-8" />

        <div class="prose prose-sm prose-neutral dark:prose-invert max-w-none">
          <PortableText value={portableTextContent} components={{ type: { code: CodeBlock } }} />
        </div>
      </>
    )}

    <hr class="border-0 border-t border-border mt-12 mb-8" />

    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
      </svg>
      Back to all projects
    </a>
  </div>
</Layout>

<style is:global>
  @reference "../../styles/global.css";

  .prose h2 {
    @apply text-xl font-semibold text-foreground mt-8 mb-3;
  }
  .prose h3 {
    @apply text-base font-semibold text-foreground mt-6 mb-2;
  }
  .prose p {
    @apply text-sm text-muted-foreground leading-relaxed mb-4;
  }
  .prose ul {
    @apply text-sm text-muted-foreground list-disc pl-5 mb-4 space-y-1;
  }
  .prose ol {
    @apply text-sm text-muted-foreground list-decimal pl-5 mb-4 space-y-1;
  }
  .prose strong {
    @apply font-semibold text-foreground;
  }
  .prose a {
    @apply text-foreground underline underline-offset-4 hover:text-muted-foreground transition-colors;
  }
  .prose blockquote {
    @apply border-l-2 border-border pl-4 italic text-muted-foreground;
  }
</style>
