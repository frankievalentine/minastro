---
import { getEmDashCollection } from "emdash";
import Layout from "../../layouts/Layout.astro";

const { entries: projects, error } = await getEmDashCollection("projects", {
  status: "published",
});

if (error) {
  throw error;
}

const sortedProjects = (projects ?? []).sort((a, b) => {
  const aDate = a.data.publishedAt;
  const bDate = b.data.publishedAt;
  if (!(aDate || bDate)) {
    return 0;
  }
  if (!aDate) {
    return 1;
  }
  if (!bDate) {
    return -1;
  }
  return bDate.valueOf() - aDate.valueOf();
});

const statusLabel: Record<string, string> = {
  active: "Active",
  wip: "WIP",
  archived: "Archived",
};

const statusClass: Record<string, string> = {
  active: "badge-secondary",
  wip: "badge-outline",
  archived: "badge-outline",
};

const featuredImage = (value: unknown, alt: string) => {
  if (typeof value === "object" && value !== null && "featuredImage" in value) value = value.featuredImage;
  if (typeof value === "string" && value.trim()) return { url: value, alt };
  if (typeof value === "object" && value !== null && "url" in value && typeof value.url === "string" && value.url.trim()) {
    return { url: value.url, alt: "alt" in value && typeof value.alt === "string" && value.alt.trim() ? value.alt : alt };
  }
  return undefined;
};
---

<Layout title="Projects" currentPage="/projects">
  <div class="max-w-2xl mx-auto px-6 py-12 md:py-16">
    <!-- Page header -->
    <div class="flex items-center gap-2 mb-3">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-muted-foreground"
        aria-hidden="true"
      >
        <path d="M3 3h7v7H3z"></path>
        <path d="M14 3h7v7h-7z"></path>
        <path d="M14 14h7v7h-7z"></path>
        <path d="M3 14h7v7H3z"></path>
      </svg>
      <span
        class="text-xs text-muted-foreground font-medium uppercase tracking-wider"
        >Work</span
      >
    </div>
    <h1 class="text-3xl font-bold tracking-tight mb-2">Projects</h1>
    <p class="text-muted-foreground text-sm mb-10">
      Things I've built, am building, or have shipped.
    </p>

    <section aria-labelledby="project-example-heading" class="mb-12">
      <div class="mb-4">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Example output</p>
        <h2 id="project-example-heading" class="mt-1 text-xl font-semibold tracking-tight">A complete project card</h2>
        <p class="mt-1.5 text-sm text-muted-foreground">This static example shows how the template presents the available EmDash fields.</p>
      </div>
      <article class="card group relative overflow-hidden transition-colors hover:bg-accent/40">
        <a href="/projects/example" aria-labelledby="project-example-card-title" class="absolute inset-0 z-0 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring">
          <span class="sr-only">View the complete project example</span>
        </a>
        <section class="pointer-events-none relative z-[1]">
          <img class="mb-5 aspect-[16/9] w-full rounded-md object-cover ring-1 ring-black/10 dark:ring-white/10" src="/featured-project.svg" alt="Abstract mountain-like lines representing a finished software project" />
          <div class="flex flex-wrap items-center gap-2">
            <h3 id="project-example-card-title" class="text-base font-semibold leading-snug text-foreground group-hover:underline">Release notes dashboard</h3>
            <span class="badge-secondary text-xs">Active</span>
            <span class="badge-outline text-xs">Featured</span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">A small dashboard that turns repository activity into readable release notes for product teams.</p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            <span class="badge-outline text-xs">Astro</span>
            <span class="badge-outline text-xs">TypeScript</span>
            <span class="badge-outline text-xs">Cloudflare</span>
          </div>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href="https://github.com/yourusername/minastro" target="_blank" rel="noopener noreferrer" class="btn-outline pointer-events-auto relative z-10 inline-flex" aria-label="View example project source on GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
              GitHub
            </a>
            <a href="https://your-domain.com" target="_blank" rel="noopener noreferrer" class="btn-outline pointer-events-auto relative z-10 inline-flex" aria-label="Visit example project live site">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
              Live site
            </a>
          </div>
        </section>
      </article>
    </section>

    <section aria-labelledby="published-projects-heading">
      <div class="mb-4">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Published in EmDash</p>
        <h2 id="published-projects-heading" class="mt-1 text-xl font-semibold tracking-tight">Latest projects</h2>
      </div>
      {sortedProjects.length > 0 ? (
        <div class="grid gap-4">
          {sortedProjects.map((project) => (
            <article class="card group h-full transition-colors hover:bg-accent/40">
              <section>
                {featuredImage(project.data, project.data.title) && <img class="mb-4 aspect-[16/9] w-full rounded-md object-cover ring-1 ring-black/10 dark:ring-white/10" src={featuredImage(project.data, project.data.title)?.url} alt={featuredImage(project.data, project.data.title)?.alt} loading="lazy" />}
                <div class="flex items-start justify-between gap-4">
                  <div class="min-w-0 flex-1">
                    <div class="mb-1 flex flex-wrap items-center gap-2">
                      <h3 class="text-base font-semibold leading-snug text-foreground"><a href={`/projects/${project.data.slug}`} class="rounded-sm hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{project.data.title}</a></h3>
                      <span class={`${statusClass[project.data.project_status ?? "active"] ?? "badge-outline"} text-xs`}>{statusLabel[project.data.project_status ?? "active"] ?? project.data.project_status ?? "active"}</span>
                    </div>
                    <p class="text-sm leading-relaxed text-muted-foreground">{project.data.description}</p>
                    {project.data.terms?.tag && project.data.terms.tag.length > 0 && <div class="mt-3 flex flex-wrap gap-1.5">{project.data.terms.tag.map((tag) => <span class="badge-outline text-xs">{tag.label ?? tag.name}</span>)}</div>}
                  </div>
                  <div class="flex shrink-0 items-center gap-2">
                    {project.data.github && <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" aria-label={`${project.data.title} on GitHub`}><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg></a>}
                    {project.data.url && <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" aria-label={`${project.data.title} website`}><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a>}
                  </div>
                </div>
              </section>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-lg border border-dashed border-border px-5 py-8">
          <h3 class="font-medium">No projects published yet</h3>
          <p class="mt-1 text-sm text-muted-foreground">New projects will appear here after they are published in the EmDash Projects collection.</p>
        </div>
      )}
    </section>
  </div>
</Layout>
