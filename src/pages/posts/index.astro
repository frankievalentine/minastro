---
import { getEmDashCollection, getSiteSettings, extractPlainText } from "emdash";
import ListingHeaderMeta from "../../components/ListingHeaderMeta.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, readingTime } from "../../utils";

const cmsSettings = await getSiteSettings();
const configuredPerPage = cmsSettings?.postsPerPage;
const dateFormat =
  typeof cmsSettings?.dateFormat === "string" ? cmsSettings.dateFormat : undefined;
const timezone =
  typeof cmsSettings?.timezone === "string" ? cmsSettings.timezone : undefined;
const perPage =
  typeof configuredPerPage === "number" &&
  Number.isInteger(configuredPerPage) &&
  configuredPerPage > 0
    ? Math.min(configuredPerPage, 100)
    : 10;

const pageParam = Astro.url.searchParams.get("page");
const parsedPage = pageParam !== null && /^\d+$/.test(pageParam)
  ? Number(pageParam)
  : Number.NaN;
const page =
  Number.isSafeInteger(parsedPage) &&
  parsedPage > 0 &&
  Number.isSafeInteger((parsedPage - 1) * perPage)
    ? parsedPage
    : 1;

const [postsResult, listingHeadersResult] = await Promise.all([
  getEmDashCollection("posts", {
    status: "published",
    limit: perPage,
    offset: (page - 1) * perPage,
    orderBy: { published_at: "desc" },
  }),
  getEmDashCollection("listing_headers", { status: "published" }),
]);

const { entries: posts, error, hasMore } = postsResult;

if (error) {
  throw error;
}

if (listingHeadersResult.error) {
  throw listingHeadersResult.error;
}

const listingHeader = listingHeadersResult.entries.find(({ id, data }) =>
  id === "listing-headers" || data.slug === "listing-headers" || data.id === "listing-headers"
)?.data;
const postsHeader = listingHeader
  ? {
      label: typeof listingHeader.posts_label === "string" ? listingHeader.posts_label : undefined,
      icon: typeof listingHeader.posts_icon === "string" ? listingHeader.posts_icon : undefined,
    }
  : { label: "Writing", icon: "posts" };

const featuredImage = (value: unknown, alt: string) => {
  if (typeof value !== "object" || value === null) return undefined;
  const { src, alt: imageAlt } = value as { src?: unknown; alt?: unknown };
  if (typeof src !== "string" || !src.trim()) return undefined;
  return { src, alt: typeof imageAlt === "string" && imageAlt.trim() ? imageAlt : alt };
};
---

<Layout title="Posts" currentPage="/posts">
  <div class="max-w-2xl mx-auto px-6 py-12 md:py-16">
    <ListingHeaderMeta label={postsHeader.label} icon={postsHeader.icon} />
    <h1 class="text-3xl font-bold tracking-tight mb-2">Posts</h1>
    <p class="text-muted-foreground text-sm mb-10">
      Notes on engineering, projects, and ideas worth sharing.
    </p>

    <section aria-labelledby="published-posts-heading">
      <div class="mb-4">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Archive</p>
        <h2 id="published-posts-heading" class="mt-1 text-xl font-semibold tracking-tight">Latest posts</h2>
      </div>
      {posts.length > 0 ? (
        <div class="grid gap-4">
          {posts.map((post) => (
            <a href={`/posts/${post.data.slug}`} class="group block rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
              <article class="card h-full transition-colors group-hover:bg-accent/40">
                <section>
                  {featuredImage(post.data.featured_image, post.data.title) && <img class="mb-4 aspect-[16/9] w-full rounded-md object-cover ring-1 ring-black/10 dark:ring-white/10" src={featuredImage(post.data.featured_image, post.data.title)?.src} alt={featuredImage(post.data.featured_image, post.data.title)?.alt} loading="lazy" />}
                  <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0 flex-1">
                      <h3 class="mb-1 text-base font-semibold leading-snug text-foreground">{post.data.title}</h3>
                      <p class="line-clamp-2 text-sm leading-relaxed text-muted-foreground">{post.data.description}</p>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </div>
                  <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                    {post.data.publishedAt && <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, dateFormat, timezone)}</time>}
                    {post.data.publishedAt && <span aria-hidden="true">·</span>}
                    <span>{readingTime(extractPlainText(post.data.content ?? []))}</span>
                    {post.data.terms?.tag?.map((tag) => <span class="badge text-xs" data-variant="secondary">{tag.label ?? tag.name}</span>)}
                  </div>
                </section>
              </article>
            </a>
          ))}
        </div>
      ) : (
        <div class="rounded-lg border border-dashed border-border px-5 py-8">
          <h3 class="font-medium">{page > 1 ? "No posts on this page" : "No posts published yet"}</h3>
          <p class="mt-1 text-sm text-muted-foreground">
            {page > 1
              ? "Use Previous to return to a page with published posts."
              : "New posts will appear here when they are published."}
          </p>
        </div>
      )}
      {(page > 1 || hasMore) && (
        <nav aria-label="Posts pagination" class="mt-6 flex items-center gap-3 border-t border-border pt-5">
          {page > 1 && (
            <a
              href={`/posts?page=${page - 1}`}
              rel="prev"
              aria-label={`Go to previous posts page, page ${page - 1}`}
              class="inline-flex min-h-10 items-center gap-1.5 rounded-md border border-border bg-background px-3 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
              Previous
            </a>
          )}
          <span class="text-xs text-muted-foreground">Page {page}</span>
          {hasMore && (
            <a
              href={`/posts?page=${page + 1}`}
              rel="next"
              aria-label={`Go to next posts page, page ${page + 1}`}
              class="ml-auto inline-flex min-h-10 items-center gap-1.5 rounded-md border border-border bg-background px-3 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              Next
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </a>
          )}
        </nav>
      )}
    </section>
  </div>
</Layout>
