---
export const prerender = false;

import { getEmDashEntry, extractPlainText } from "emdash";
import { PortableText } from "emdash/ui";
import BackToTop from "../../components/ui/BackToTop.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, readingTime } from "../../utils";

const slug = Astro.params.slug;
if (!slug) {
  return new Response(null, { status: 404 });
}

interface PostTag {
  label: string;
  name: string;
}

interface PostData {
  title: string;
  description: string;
  publishedAt: Date | null;
  slug: string;
  tags: PostTag[];
  featuredImage?: { url: string; alt: string };
}

const featuredImage = (value: unknown, alt: string) => {
  if (typeof value === "object" && value !== null && "featuredImage" in value) value = value.featuredImage;
  if (typeof value === "string" && value.trim()) return { url: value, alt };
  if (typeof value === "object" && value !== null && "url" in value && typeof value.url === "string" && value.url.trim()) {
    return { url: value.url, alt: "alt" in value && typeof value.alt === "string" && value.alt.trim() ? value.alt : alt };
  }
  return undefined;
};

const { entry, error, isPreview } = await getEmDashEntry("posts", slug);

if (error) {
  return new Response("Server error", { status: 500 });
}

if (!entry) {
  return new Response(null, { status: 404 });
}

if (entry.data.status !== "published" && !isPreview) {
  return new Response(null, { status: 404 });
}

const portableTextContent = entry.data.content;
const contentRaw = extractPlainText(portableTextContent);
const postData: PostData = {
  title: entry.data.title,
  description: entry.data.description,
  publishedAt: entry.data.publishedAt,
  slug: entry.data.slug ?? slug,
  tags: (entry.data.terms?.tag ?? []).map((tag) => ({
    label: tag.label ?? tag.name,
    name: tag.name,
  })),
  featuredImage: featuredImage(entry.data, entry.data.title),
};

const timeToRead = readingTime(contentRaw);
---

<Layout
  title={postData.title}
  description={postData.description}
  currentPage={`/posts/${postData.slug}`}
>
  <div class="max-w-2xl mx-auto px-6 py-12 md:py-16">
    <!-- Back link -->
    <a
      href="/posts"
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-8"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
      </svg>
      All posts
    </a>

    <!-- Post header -->
    <header class="mb-8">
      <h1
        class="text-3xl font-bold tracking-tight text-foreground leading-tight mb-3"
      >
        {postData.title}
      </h1>
      <p class="text-muted-foreground leading-relaxed mb-4">
        {postData.description}
      </p>
      {postData.featuredImage && <img class="mb-4 aspect-[16/9] w-full rounded-md object-cover" src={postData.featuredImage.url} alt={postData.featuredImage.alt} />}
      <div class="flex items-center gap-3 flex-wrap">
        {postData.publishedAt && (
          <>
            <time
              datetime={postData.publishedAt.toISOString()}
              class="text-sm text-muted-foreground"
            >
              {formatDate(postData.publishedAt)}
            </time>
            <span class="text-border" aria-hidden="true">·</span>
          </>
        )}
        <span class="text-sm text-muted-foreground">{timeToRead}</span>
        {postData.tags.length > 0 && (
          <>
            <span class="text-border" aria-hidden="true">·</span>
            <div class="flex gap-1.5 flex-wrap">
              {postData.tags.map((tag) => (
                <span class="badge-outline text-xs">{tag.label}</span>
              ))}
            </div>
          </>
        )}
      </div>
    </header>

    <div role="separator" class="border-t border-border mb-8"></div>

    <!-- Post body -->
    <div class="prose prose-sm prose-neutral dark:prose-invert max-w-none">
      <PortableText value={portableTextContent} components={{ type: { code: CodeBlock } }} />
    </div>

    <div role="separator" class="border-t border-border mt-12 mb-8"></div>

    <!-- Footer nav -->
    <a
      href="/posts"
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
      </svg>
      Back to all posts
    </a>
  </div>

  <BackToTop />
</Layout>

<style is:global>
  @reference "../../styles/global.css";

  .prose h2 {
    @apply text-xl font-semibold text-foreground mt-8 mb-3;
  }
  .prose h3 {
    @apply text-base font-semibold text-foreground mt-6 mb-2;
  }
  .prose p {
    @apply text-sm text-muted-foreground leading-relaxed mb-4;
  }
  .prose ul {
    @apply text-sm text-muted-foreground list-disc pl-5 mb-4 space-y-1;
  }
  .prose ol {
    @apply text-sm text-muted-foreground list-decimal pl-5 mb-4 space-y-1;
  }
  .prose strong {
    @apply font-semibold text-foreground;
  }
  .prose a {
    @apply text-foreground underline underline-offset-4 hover:text-muted-foreground transition-colors;
  }
  .prose blockquote {
    @apply border-l-2 border-border pl-4 italic text-muted-foreground;
  }
</style>
