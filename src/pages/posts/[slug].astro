---
export const prerender = false;

import { getCollectionInfo, getEmDashEntry, getSiteSettings, extractPlainText } from "emdash";
import { CommentForm, Comments, PortableText } from "emdash/ui";
import BackToTop from "../../components/ui/BackToTop.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, readingTime } from "../../utils";

const slug = Astro.params.slug;
if (!slug) {
  return new Response(null, { status: 404 });
}

interface PostTag {
  label: string;
  name: string;
}

interface PostData {
  title: string;
  description: string;
  publishedAt: Date | null;
  slug: string;
  tags: PostTag[];
  featuredImage?: { src: string; alt: string };
}

const featuredImage = (value: unknown, alt: string) => {
  if (typeof value !== "object" || value === null) return undefined;
  const { src, alt: imageAlt } = value as { src?: unknown; alt?: unknown };
  if (typeof src !== "string" || !src.trim()) return undefined;
  return { src, alt: typeof imageAlt === "string" && imageAlt.trim() ? imageAlt : alt };
};

const { entry, error, isPreview } = await getEmDashEntry("posts", slug);

if (error) {
  return new Response("Server error", { status: 500 });
}

if (!entry) {
  return new Response(null, { status: 404 });
}

if (entry.data.status !== "published" && !isPreview) {
  return new Response(null, { status: 404 });
}

const [cmsSettings, postsCollection] = await Promise.all([
  getSiteSettings(),
  getCollectionInfo("posts"),
]);
const dateFormat =
  typeof cmsSettings.dateFormat === "string" ? cmsSettings.dateFormat : undefined;
const timezone =
  typeof cmsSettings.timezone === "string" ? cmsSettings.timezone : undefined;
const commentsEnabled = postsCollection?.commentsEnabled ?? false;
const showComments = commentsEnabled && entry.data.status === "published";
const portableTextContent = entry.data.content;
const contentRaw = extractPlainText(portableTextContent);
const postData: PostData = {
  title: entry.data.title,
  description: entry.data.description,
  publishedAt: entry.data.publishedAt,
  slug: entry.data.slug ?? slug,
  tags: (entry.data.terms?.tag ?? []).map((tag) => ({
    label: tag.label ?? tag.name,
    name: tag.name,
  })),
  featuredImage: featuredImage(entry.data.featured_image, entry.data.title),
};

const timeToRead = readingTime(contentRaw);
---

<Layout
  title={postData.title}
  description={postData.description}
  currentPage={`/posts/${postData.slug}`}
>
  <div class="max-w-2xl mx-auto px-6 py-12 md:py-16">
    <!-- Back link -->
    <a
      href="/posts"
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-8"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
      </svg>
      All posts
    </a>

    <!-- Post header -->
    <header class="mb-8">
      <h1
        class="text-3xl font-bold tracking-tight text-foreground leading-tight mb-3"
      >
        {postData.title}
      </h1>
      <p class="text-muted-foreground leading-relaxed mb-4">
        {postData.description}
      </p>
      {postData.featuredImage && <img class="mb-4 aspect-[16/9] w-full rounded-md object-cover" src={postData.featuredImage.src} alt={postData.featuredImage.alt} />}
      <div class="flex items-center gap-3 flex-wrap">
        {postData.publishedAt && (
          <>
            <time
              datetime={postData.publishedAt.toISOString()}
              class="text-sm text-muted-foreground"
            >
              {formatDate(postData.publishedAt, dateFormat, timezone)}
            </time>
            <span class="text-border" aria-hidden="true">·</span>
          </>
        )}
        <span class="text-sm text-muted-foreground">{timeToRead}</span>
        {postData.tags.length > 0 && (
          <>
            <span class="text-border" aria-hidden="true">·</span>
            <div class="flex gap-1.5 flex-wrap">
              {postData.tags.map((tag) => (
                <span class="badge text-xs" data-variant="outline">{tag.label}</span>
              ))}
            </div>
          </>
        )}
      </div>
    </header>

    <hr class="border-0 border-t border-border mb-8" />

    <!-- Post body -->
    <div class="prose prose-sm prose-neutral dark:prose-invert max-w-none">
      <PortableText value={portableTextContent} components={{ type: { code: CodeBlock } }} />
    </div>

    {showComments && (
      <>
        <hr class="border-0 border-t border-border mt-12 mb-8" />

        <section aria-labelledby="comments-heading">
          <div class="mb-6">
            <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Conversation</p>
            <h2 id="comments-heading" class="mt-1 text-xl font-semibold tracking-tight">Discussion</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
              Share a question, response, or useful detail about this post.
            </p>
          </div>

          <Comments
            collection="posts"
            contentId={entry.data.id}
            threaded
            class="post-comments-list"
          />

          <div class="mt-8 rounded-lg border border-border bg-card p-5 sm:p-6">
            <h3 class="text-base font-semibold tracking-tight">Leave a comment</h3>
            {postsCollection?.commentsModeration === "first_time" ? (
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                Your first comment may need approval before it appears.
              </p>
            ) : postsCollection?.commentsModeration === "all" ? (
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                Comments may need approval before they appear.
              </p>
            ) : null}
            <CommentForm
              collection="posts"
              contentId={entry.data.id}
              class="post-comment-form mt-5"
            />
          </div>
        </section>
      </>
    )}

    <hr class="border-0 border-t border-border mt-12 mb-8" />

    <!-- Footer nav -->
    <a
      href="/posts"
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
      </svg>
      Back to all posts
    </a>
  </div>

  <BackToTop />
</Layout>

<style is:global>
  @reference "../../styles/global.css";

  .prose h2 {
    @apply text-xl font-semibold text-foreground mt-8 mb-3;
  }
  .prose h3 {
    @apply text-base font-semibold text-foreground mt-6 mb-2;
  }
  .prose p {
    @apply text-sm text-muted-foreground leading-relaxed mb-4;
  }
  .prose ul {
    @apply text-sm text-muted-foreground list-disc pl-5 mb-4 space-y-1;
  }
  .prose ol {
    @apply text-sm text-muted-foreground list-decimal pl-5 mb-4 space-y-1;
  }
  .prose strong {
    @apply font-semibold text-foreground;
  }
  .prose a {
    @apply text-foreground underline underline-offset-4 hover:text-muted-foreground transition-colors;
  }
  .prose blockquote {
    @apply border-l-2 border-border pl-4 italic text-muted-foreground;
  }

  .post-comments-list {
    --ec-comment-gap: 1.5rem;
    --ec-comment-indent: 1.5rem;
    --ec-comment-border: 1px solid var(--border);
  }
  .post-comments-list .ec-comments-heading {
    @apply mb-5 text-sm font-medium text-foreground;
  }
  .post-comments-list .ec-comment-header {
    @apply gap-x-2 gap-y-0.5;
  }
  .post-comments-list .ec-comment-author {
    @apply text-sm font-semibold text-foreground;
  }
  .post-comments-list .ec-comment-date {
    @apply text-xs text-muted-foreground;
    opacity: 1;
  }
  .post-comments-list .ec-comment-body {
    @apply mt-2 text-sm leading-relaxed text-muted-foreground;
  }
  .post-comments-list .ec-comment-body a {
    @apply text-foreground underline underline-offset-4 transition-colors hover:text-muted-foreground;
  }
  .post-comments-list .ec-comment-badge {
    @apply text-muted-foreground;
  }

  .post-comment-form {
    --ec-form-gap: 0.875rem;
    --ec-form-bg: var(--background);
    --ec-form-border: var(--border);
    --ec-form-color: var(--foreground);
    --ec-form-user-bg: var(--muted);
    --ec-form-user-bg-dark: var(--muted);
    --ec-form-user-border: var(--border);
    --ec-form-submit-bg: var(--foreground);
    --ec-form-submit-color: var(--background);
    --ec-form-success-color: var(--foreground);
    --ec-form-error-color: var(--destructive);
  }
  .post-comment-form .ec-comment-form-field {
    @apply gap-1.5 text-sm font-medium text-foreground;
  }
  .post-comment-form .ec-comment-form-field input,
  .post-comment-form .ec-comment-form-field textarea {
    @apply rounded-md px-3 py-2.5 text-base leading-normal shadow-sm transition-colors;
  }
  .post-comment-form .ec-comment-form-field textarea {
    min-height: 7rem;
    resize: vertical;
  }
  .post-comment-form .ec-comment-form-field input:hover,
  .post-comment-form .ec-comment-form-field textarea:hover {
    border-color: color-mix(in oklch, var(--border) 65%, var(--foreground));
  }
  .post-comment-form .ec-comment-form-field input:focus-visible,
  .post-comment-form .ec-comment-form-field textarea:focus-visible,
  .post-comment-form .ec-comment-form-submit:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .post-comment-form .ec-comment-user-info {
    @apply flex-wrap rounded-md text-sm text-muted-foreground;
  }
  .post-comment-form .ec-comment-user-name {
    @apply text-foreground;
  }
  .post-comment-form .ec-comment-form-submit {
    @apply min-h-10 rounded-md px-4 text-sm transition-opacity hover:opacity-85;
  }
  .post-comment-form .ec-comment-form-status {
    @apply text-sm leading-relaxed;
  }

  @media (max-width: 30rem) {
    .post-comments-list {
      --ec-comment-indent: 1rem;
    }
  }
</style>
