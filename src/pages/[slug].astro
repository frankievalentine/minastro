---
export const prerender = false;

import { decodeSlug, getEmDashEntry } from "emdash";
import type { PortableTextBlock } from "emdash";
import CmsPageView from "../components/CmsPageView.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) {
  return new Response(null, { status: 404 });
}

const { entry, error, isPreview } = await getEmDashEntry("pages", slug);

if (error) {
  throw error;
}

if (!entry) {
  return new Response(null, { status: 404 });
}

const page = entry.data as {
  content?: unknown;
  description?: unknown;
  slug?: unknown;
  status?: unknown;
  title?: unknown;
};

if (page.status !== "published" && !isPreview) {
  return new Response(null, { status: 404 });
}

if (typeof page.title !== "string" || typeof page.description !== "string") {
  throw new Error("The CMS page is missing its required title or description.");
}

const pageSlug = typeof page.slug === "string" ? page.slug : slug;
const content = Array.isArray(page.content)
  ? (page.content as PortableTextBlock[])
  : [];
---

<CmsPageView
  title={page.title}
  description={page.description}
  currentPage={`/${pageSlug}`}
  content={content}
/>
