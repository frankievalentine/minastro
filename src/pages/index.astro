---
import { getEmDashCollection, extractPlainText, type PortableTextBlock } from "emdash";
import HomeHighlightIcon from "../components/HomeHighlightIcon.astro";
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../site.config";
import { formatDate, readingTime } from "../utils";
type FeaturedImage = { src: string; alt: string };
type HomepagePost = { title: string; slug: string; description: string; publishedAt: Date | null; content: PortableTextBlock[]; tags: string[]; featuredImage?: FeaturedImage };
type HomepageProject = { title: string; slug: string; description: string; publishedAt: Date | null; featured: boolean; project_status: string | undefined; tags: string[]; featuredImage?: FeaturedImage };
type HighlightIcon = "database" | "workflow" | "search" | "mail";

const highlightIcons = new Set<HighlightIcon>(["database", "workflow", "search", "mail"]);

const requiredString = (data: object, key: string, collection: string): string => {
  const value = (data as Record<string, unknown>)[key];
  if (typeof value !== "string" || !value.trim()) {
    throw new Error(`The CMS ${collection} entry is missing its required ${key} field.`);
  }
  return value;
};

const optionalString = (data: object, key: string): string | undefined => {
  const value = (data as Record<string, unknown>)[key];
  return typeof value === "string" && value.trim() ? value : undefined;
};

const safeCtaHref = (value: string): string => {
  if (value.startsWith("/") && !value.startsWith("//")) return value;
  try {
    const url = new URL(value);
    if (url.protocol === "http:" || url.protocol === "https:") return value;
  } catch {
    // The validation error below identifies the CMS field that needs correction.
  }
  throw new Error("The CMS home entry has an invalid newsletter_cta_href field.");
};

const toDate = (value: unknown): Date | null => value instanceof Date ? value : null;
const toFeaturedImage = (value: unknown, fallbackAlt: string): FeaturedImage | undefined => {
  if (typeof value !== "object" || value === null) return undefined;
  const { src, alt } = value as { src?: unknown; alt?: unknown };
  if (typeof src !== "string" || !src.trim()) return undefined;
  return { src, alt: typeof alt === "string" && alt.trim() ? alt : fallbackAlt };
};

const [homeResult, highlightsResult, postsResult, projectsResult] = await Promise.all([
  getEmDashCollection("home", { status: "published" }),
  getEmDashCollection("home_highlights", {
    status: "published",
    orderBy: { sort_order: "asc" },
  }),
  getEmDashCollection("posts", { status: "published" }),
  getEmDashCollection("projects", { status: "published" }),
]);

if (homeResult.error) {
  throw homeResult.error;
}

if (highlightsResult.error) {
  throw highlightsResult.error;
}

if (postsResult.error) {
  throw postsResult.error;
}

if (projectsResult.error) {
  throw projectsResult.error;
}

const homeData = homeResult.entries.find(({ id, data }) =>
  id === "home" || data.slug === "home" || data.id === "home"
)?.data;
const home = homeData ? {
  eyebrow: optionalString(homeData, "eyebrow"),
  title: requiredString(homeData, "title", "home"),
  description: requiredString(homeData, "description", "home"),
  highlightsTitle: requiredString(homeData, "highlights_title", "home"),
  highlightsDescription: optionalString(homeData, "highlights_description"),
  postsTitle: requiredString(homeData, "posts_title", "home"),
  postsDescription: optionalString(homeData, "posts_description"),
  projectsTitle: requiredString(homeData, "projects_title", "home"),
  projectsDescription: optionalString(homeData, "projects_description"),
  newsletterCtaLabel: requiredString(homeData, "newsletter_cta_label", "home"),
  newsletterCtaHref: safeCtaHref(requiredString(homeData, "newsletter_cta_href", "home")),
} : null;

const highlights = highlightsResult.entries.map(({ data }) => {
  const iconKey = data.icon_key;
  if (typeof iconKey !== "string" || !highlightIcons.has(iconKey as HighlightIcon)) {
    throw new Error("A CMS home_highlights entry has an invalid icon_key field.");
  }
  return {
    title: requiredString(data, "title", "home_highlights"),
    description: requiredString(data, "description", "home_highlights"),
    icon: iconKey as HighlightIcon,
  };
});

const posts: HomepagePost[] = postsResult.entries.map((post) => ({
  title: post.data.title,
  slug: post.data.slug ?? "",
  description: post.data.description,
  publishedAt: toDate(post.data.publishedAt),
  content: post.data.content ?? [],
  tags: (post.data.terms?.tag ?? []).map((tag) => tag.label ?? tag.name),
  featuredImage: toFeaturedImage(post.data.featured_image, post.data.title),
}));

const projects: HomepageProject[] = projectsResult.entries.map((project) => ({
  title: project.data.title,
  slug: project.data.slug ?? "",
  description: project.data.description,
  publishedAt: toDate(project.data.publishedAt),
  featured: project.data.featured ?? false,
  project_status: project.data.project_status,
  tags: (project.data.terms?.tag ?? []).map((tag) => tag.label ?? tag.name),
  featuredImage: toFeaturedImage(project.data.featured_image, project.data.title),
}));

const latestPosts = posts
  .sort((a, b) => (b.publishedAt?.getTime() ?? 0) - (a.publishedAt?.getTime() ?? 0))
  .slice(0, 3);
const selectedProjects = projects
  .filter((project) => project.featured)
  .sort((a, b) => (b.publishedAt?.getTime() ?? 0) - (a.publishedAt?.getTime() ?? 0))
  .slice(0, 3);
const statusLabel: Record<string, string> = { active: "Active", wip: "WIP", archived: "Archived" };
---

<Layout title={home?.title ?? "Home"} description={home?.description} currentPage="/">
  <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
    {home ? (
      <>
        <header class="mb-12 max-w-2xl">
          {home.eyebrow && (
            <div class="mb-3">
              <span class="badge" data-variant="secondary">{home.eyebrow}</span>
            </div>
          )}
          <h1 class="text-3xl font-bold tracking-tight text-foreground">{home.title}</h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">{home.description}</p>
        </header>

        <section aria-labelledby="highlighted-features-heading" class="mt-12">
          <div class="mb-4 max-w-xl">
            <h2 id="highlighted-features-heading" class="mt-1 text-xl font-semibold tracking-tight">{home.highlightsTitle}</h2>
            {home.highlightsDescription && <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{home.highlightsDescription}</p>}
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {highlights.map((highlight) => (
              <article class="card">
                <section class="flex gap-3">
                  <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-secondary text-secondary-foreground" aria-hidden="true">
                    <HomeHighlightIcon icon={highlight.icon} />
                  </span>
                  <div>
                    <h3 class="text-sm font-semibold text-foreground">{highlight.title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{highlight.description}</p>
                  </div>
                </section>
              </article>
            ))}
          </div>
        </section>

        <div class="mt-12 grid gap-8 md:grid-cols-2">
          <section aria-labelledby="latest-writing-heading" class="card flex h-full flex-col">
            <header>
              <div class="flex items-baseline justify-between gap-3">
                <h2 id="latest-writing-heading">{home.postsTitle}</h2>
                <a href="/posts" class="text-xs text-muted-foreground hover:text-foreground">View all</a>
              </div>
              {home.postsDescription && <p class="mt-1.5">{home.postsDescription}</p>}
            </header>
            <section class="flex-1">
              {latestPosts.length > 0 ? (
                <ul class="grid gap-4">
                  {latestPosts.map((post) => (
                    <li>
                      <a href={`/posts/${post.slug}`} class="group block rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                        {post.featuredImage && <img class="mb-3 aspect-[16/9] w-full rounded-md object-cover" src={post.featuredImage.src} alt={post.featuredImage.alt} loading="lazy" />}
                        <h3 class="font-medium leading-snug group-hover:underline">{post.title}</h3>
                        <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{post.description}</p>
                        <p class="mt-2 text-xs text-muted-foreground">
                          {post.publishedAt ? formatDate(post.publishedAt) : "Recently"} · {readingTime(extractPlainText(post.content))}
                        </p>
                        {post.tags.length > 0 && <div class="mt-3 flex flex-wrap gap-1.5">{post.tags.map((tag) => <span class="badge text-xs" data-variant="outline">{tag}</span>)}</div>}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <div class="rounded-md border border-dashed border-border px-4 py-6">
                  <p class="font-medium">Latest posts will appear here</p>
                  <p class="mt-1 text-sm text-muted-foreground">New writing will appear here when it is published.</p>
                </div>
              )}
            </section>
          </section>

          <section aria-labelledby="selected-work-heading" class="card flex h-full flex-col">
            <header>
              <div class="flex items-baseline justify-between gap-3">
                <h2 id="selected-work-heading">{home.projectsTitle}</h2>
                <a href="/projects" class="text-xs text-muted-foreground hover:text-foreground">View all</a>
              </div>
              {home.projectsDescription && <p class="mt-1.5">{home.projectsDescription}</p>}
            </header>
            <section class="flex-1">
              {selectedProjects.length > 0 ? (
                <ul class="grid gap-4">
                  {selectedProjects.map((project) => (
                    <li>
                      <a href={`/projects/${project.slug}`} class="group block rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                        {project.featuredImage && <img class="mb-3 aspect-[16/9] w-full rounded-md object-cover" src={project.featuredImage.src} alt={project.featuredImage.alt} loading="lazy" />}
                        <div class="flex items-center gap-2">
                          <h3 class="font-medium leading-snug group-hover:underline">{project.title}</h3>
                          {project.project_status && <span class="badge text-xs" data-variant="outline">{statusLabel[project.project_status] ?? project.project_status}</span>}
                        </div>
                        <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{project.description}</p>
                        {project.tags.length > 0 && <div class="mt-3 flex flex-wrap gap-1.5">{project.tags.map((tag) => <span class="badge text-xs" data-variant="outline">{tag}</span>)}</div>}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <div class="rounded-md border border-dashed border-border px-4 py-6">
                  <p class="font-medium">Featured projects will appear here</p>
                  <p class="mt-1 text-sm text-muted-foreground">Selected work will appear here as projects are published.</p>
                </div>
              )}
            </section>
          </section>
        </div>

        {siteConfig.newsletter.enabled && (
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={home.newsletterCtaHref} class="btn">{home.newsletterCtaLabel}</a>
          </div>
        )}
      </>
    ) : (
      <section class="rounded-lg border border-dashed border-border px-5 py-8" aria-labelledby="home-empty-heading">
        <h1 id="home-empty-heading" class="font-medium">Homepage content is not available yet</h1>
        <p class="mt-1 text-sm text-muted-foreground">Please check back soon.</p>
      </section>
    )}
  </div>
</Layout>
