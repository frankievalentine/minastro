{
  "name": "minastro",
  "type": "module",
  "version": "0.1.0",
  "description": "A minimal Astro personal site template with blog, projects, newsletter, and search.",
  "keywords": [
    "astro",
    "astro-template",
    "blog",
    "portfolio",
    "tailwind"
  ],
  "emdash": {
    "label": "minastro",
    "description": "A minimal personal-site theme for EmDash.",
    "seed": ".emdash/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro telemetry disable && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cf:dev": "bun run build && wrangler dev",
    "cf:deploy": "bun run build && wrangler deploy",
    "cloudflare:setup": "bun run scripts/setup-cloudflare.ts",
    "check": "astro check && eslint .",
    "fix": "eslint --fix .",
    "seed:validate": "bun run scripts/validate-seed.ts",
    "types:generate": "bun run scripts/generate-types.ts",
    "newsletter:migrate:local": "bunx wrangler d1 migrations apply NEWSLETTER_DB --local",
    "newsletter:migrate:remote": "bunx wrangler d1 migrations apply NEWSLETTER_DB --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@emdash-cms/cloudflare": "^0.32.0",
    "@shikijs/engine-javascript": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "basecoat-css": "^0.3.11",
    "emdash": "^0.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^9.39.5",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.120.1"
  }
}
