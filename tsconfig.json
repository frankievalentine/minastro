{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    // TypeScript 6 no longer includes every installed @types package by
    // default. Bun's globals and bun:* modules are used by scripts and tests;
    // Cloudflare Workers types are referenced from src/env.d.ts.
    "types": ["bun"]
  }
}
